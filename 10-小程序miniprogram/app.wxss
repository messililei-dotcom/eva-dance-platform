page {
  min-height: 100%;
  background: #f6f6f6;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1.3;
}

button::after {
  border: 0;
}

.page {
  padding: 28rpx 28rpx 44rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #202124;
}

.section-title .more {
  font-size: 26rpx;
  font-weight: 500;
  color: #9f1d20;
}

.card {
  border: 1rpx solid rgba(32, 33, 36, 0.06);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(32, 33, 36, 0.05);
}

.primary-btn,
.ghost-btn,
.gold-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-btn {
  color: #ffffff;
  background: #9f1d20;
}

.gold-btn {
  color: #ffffff;
  background: #9f1d20;
}

.ghost-btn {
  color: #9f1d20;
  border: 1rpx solid #dcb5b6;
  background: #ffffff;
}

.muted {
  color: #616773;
}

.price {
  color: #9f1d20;
  font-weight: 800;
}

.empty {
  padding: 56rpx 24rpx;
  text-align: center;
  color: #616773;
}


.public-share-preview{padding:40rpx;display:flex;flex-direction:column;gap:28rpx;background:#fff;min-height:80vh;box-sizing:border-box}.public-share-preview-image{width:100%;height:420rpx;background:#f7f3ee;border-radius:20rpx}.public-share-preview-title{font-size:36rpx;line-height:1.7;color:#3b251e;font-weight:600}.public-share-preview-hint{font-size:26rpx;line-height:1.8;color:#616773}

/* Shared course prices use the same backend quote across list and playback. */
.course-pricing{display:flex;align-items:baseline;flex-wrap:wrap;gap:8rpx 16rpx;margin-top:12rpx;font-variant-numeric:tabular-nums}
.course-sale-price{color:#9f1d20;font-size:30rpx;font-weight:700}
.course-original-price{color:#616773;font-size:23rpx;text-decoration:line-through}

.course-unlocked{color:#15803d;font-weight:600;font-size:26rpx;line-height:1.5}.course-learn-action{color:#15803d;font-size:24rpx;margin-left:12rpx;white-space:nowrap;}

/* App parity: native Mini Program primitives, compact controls and continuous rows. */
.row-pressed{opacity:.65}
.catalog-filters{width:100%;white-space:nowrap;margin:12rpx 0}
.catalog-filter-row{display:inline-flex;align-items:center;gap:12rpx}
.catalog-chip{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;min-height:88rpx;margin:0;padding:12rpx 24rpx;border-radius:12rpx;background:#f3f4f6;color:#616773;font-size:26rpx;line-height:1.4;white-space:nowrap}
.catalog-chip.selected{background:#f9eaea;color:#9f1d20;font-weight:600}
.catalog-search{display:flex;align-items:center;gap:12rpx;min-height:88rpx;border-bottom:1rpx solid #d9dde3;margin:12rpx 0}
.catalog-search input{flex:1;min-width:0;height:88rpx;font-size:28rpx}
.catalog-search button{flex-shrink:0;min-width:88rpx;min-height:88rpx;font-size:34rpx;color:#616773}
