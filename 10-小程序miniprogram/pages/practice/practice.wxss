.practice-hero {
  padding: 38rpx 32rpx 30rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #3b2830 0%, #aa5242 56%, #df8f54 100%);
}

.hero-label {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ffe7c8;
  background: rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 36rpx;
  font-size: 52rpx;
  font-weight: 900;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-stats view {
  display: grid;
  gap: 6rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-stats text:first-child {
  font-size: 36rpx;
  font-weight: 900;
}

.hero-stats text:last-child {
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 16rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.section-head text {
  color: #b8b8b8;
  font-size: 28rpx;
  font-weight: 500;
}

.practice-card {
  display: grid;
  grid-template-columns: 146rpx 1fr;
  gap: 24rpx;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #fff7ef;
  border: 1rpx solid rgba(181, 117, 76, 0.16);
}

.practice-ring {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: grid;
  place-content: center;
  color: #ffffff;
  background: #ff5b45;
  border: 10rpx solid #f3d7bd;
  text-align: center;
}

.practice-ring text:first-child {
  font-size: 38rpx;
  font-weight: 900;
}

.practice-ring text:last-child {
  font-size: 22rpx;
  font-weight: 700;
}

.practice-tag {
  display: inline-flex;
  max-width: 180rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #a44d39;
  background: rgba(255, 91, 69, 0.1);
  font-size: 22rpx;
  font-weight: 800;
}

.practice-title {
  margin-top: 10rpx;
  color: #202124;
  font-size: 34rpx;
  font-weight: 900;
}

.practice-desc {
  margin-top: 10rpx;
  color: #7c7065;
  font-size: 27rpx;
  line-height: 1.55;
}

.practice-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.practice-steps text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6f665d;
  background: #ffffff;
  font-size: 23rpx;
}

.training-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.week-card {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  padding: 22rpx;
}

.week-item {
  display: grid;
  justify-items: center;
  gap: 10rpx;
}

.week-dot {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #8c8172;
  background: #f4eee8;
  font-size: 24rpx;
  font-weight: 900;
}

.week-item.done .week-dot {
  color: #ffffff;
  background: #ff5b45;
}

.week-label {
  color: #8c8172;
  font-size: 22rpx;
}

.assist-list {
  display: grid;
  gap: 16rpx;
}

.assist-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.assist-title {
  font-size: 31rpx;
  font-weight: 900;
}

.assist-desc {
  margin-top: 8rpx;
  color: #8c8172;
  font-size: 25rpx;
  line-height: 1.45;
}

.assist-action {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #ff5b45;
  background: #fff2ee;
  font-size: 25rpx;
  font-weight: 800;
}

.recommend-list {
  display: grid;
  gap: 16rpx;
}

.recommend-card {
  display: grid;
  grid-template-columns: 132rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 18rpx;
  overflow: hidden;
}

.recommend-cover {
  width: 156rpx;
  height: 117rpx;
  aspect-ratio: 4 / 3;
  border-radius: 14rpx;
  overflow: hidden;
  display: grid;
  place-items: center;
  color: #ffffff;
  background: linear-gradient(145deg, #2d3541, #b56a48);
  font-size: 36rpx;
  font-weight: 900;
}

.recommend-cover image {
  width: 100%;
  height: 100%;
}

.recommend-main {
  min-width: 0;
  display: grid;
  align-content: center;
  gap: 10rpx;
}

.recommend-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.recommend-badge {
  max-width: 180rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #a44d39;
  background: rgba(255, 91, 69, 0.1);
  font-size: 22rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-price {
  flex: 0 0 auto;
  color: #ff5b45;
  font-size: 24rpx;
  font-weight: 900;
}

.recommend-title {
  color: #202124;
  font-size: 30rpx;
  line-height: 1.32;
  font-weight: 900;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-meta {
  color: #8c8172;
  font-size: 24rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
