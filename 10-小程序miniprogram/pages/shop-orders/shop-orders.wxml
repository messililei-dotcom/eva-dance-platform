<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}"><template is="publicSharePreview" data="{{card:sharePreview}}" /></block>
<block wx:else>
<view class="shop-page"><view class="shop-header"><text class="brand">我的订单</text><button class="outline" bindtap="mall">逛商城</button></view>
 <view wx:if="{{loading}}" class="empty">正在加载订单…</view><view wx:elif="{{error}}" class="empty">{{error}}<button class="outline" bindtap="reload">重新加载</button></view><view wx:elif="{{!orders.length}}" class="empty">暂无订单</view>
 <view class="panel" wx:for="{{orders}}" wx:key="id"><view class="row"><text class="muted">{{item.createdText}}</text><text class="status">{{item.statusText}}</text></view><view class="order-id">{{item.id}}</view><view wx:for="{{item.items}}" wx:for-item="line" wx:key="product_id" class="order-line"><text>{{line.name}} {{line.spec}}</text><text>¥{{line.priceText}} × {{line.quantity}}</text></view><view class="row"><text>订单金额</text><text class="price">¥{{item.totalText}}</text></view><view class="shipping">{{item.recipient}} · {{item.phone}}<view>{{item.address}}</view></view><view wx:if="{{item.trackingNo}}" class="shipping">{{item.carrier}} {{item.trackingNo}}<button class="text-button" bindtap="copyTracking" data-number="{{item.trackingNo}}">复制快递单号</button></view><view wx:if="{{item.refundReason}}" class="muted">退款原因：{{item.refundReason}}</view>
 <view class="actions"><button wx:if="{{item.status==='completed' && item.kind!=='goods'}}" class="primary" bindtap="openCourse" data-id="{{item.id}}">{{item.kind==='event' ? '查看赛事报名' : item.kind==='online' ? '查看已购课程' : '查看课次并约课'}}</button><button class="outline" disabled="{{busy}}" data-id="{{item.id}}" data-action="refresh" bindtap="action">刷新状态</button><button wx:if="{{item.status==='pending'}}" class="outline" disabled="{{busy}}" data-id="{{item.id}}" data-action="cancel" bindtap="action">取消订单</button><button wx:if="{{item.status==='pending'}}" class="primary" disabled="{{busy}}" data-id="{{item.id}}" data-action="pay" bindtap="action">继续付款</button><button wx:if="{{item.status==='shipped'}}" class="primary" disabled="{{busy}}" data-id="{{item.id}}" data-action="received" bindtap="action">确认收货</button><button wx:if="{{item.status==='paid' || item.status==='shipped' || item.status==='completed'}}" class="outline" disabled="{{busy}}" data-id="{{item.id}}" data-action="refund" bindtap="action">申请退款</button></view></view>
</view>

</block>
