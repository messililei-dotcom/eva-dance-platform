<view class="page">
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 头像区域 -->
    <view class="avatar-section card">
      <view class="avatar-row">
        <text class="avatar-label">头像</text>
        <view class="avatar">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{displayInitial}}</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="form-section card">
      <view class="form-item">
        <text class="form-label">学员等级</text>
        <text class="form-value readonly">{{levelText}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" type="text" value="{{name}}" bindblur="onNameInput" placeholder="请输入姓名" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="text" value="{{phone}}" bindblur="onPhoneInput" placeholder="请输入手机号" maxlength="11" />
      </view>
      <view class="form-item" bindtap="onGenderTap">
        <text class="form-label">性别</text>
        <text class="form-value actionable">{{genderText}} ›</text>
      </view>
      <view class="form-item">
        <text class="form-label">生日</text>
        <input class="form-input" type="text" value="{{birthday}}" bindblur="onBirthdayInput" placeholder="YYYY-MM-DD" />
      </view>
      <!-- 省市区选择器 -->
      <view class="form-item">
        <text class="form-label">所在地区</text>
        <picker mode="region" bindchange="onRegionChange" value="{{regionValues}}">
          <text class="form-value actionable" wx:if="{{regionText}}">{{regionText}} ›</text>
          <text class="form-value actionable" wx:else>请选择省份/城市 ›</text>
        </picker>
      </view>
      <!-- 详细地址 -->
      <view class="form-item">
        <text class="form-label">详细地址</text>
        <input class="form-input" type="text" value="{{address}}" bindblur="onAddressInput" placeholder="请输入详细地址" />
      </view>
      <view class="form-item">
        <text class="form-label">注册日期</text>
        <text class="form-value readonly">{{registeredAt.slice(0,10) || '未记录'}}</text>
      </view>
    </view>

    <!-- 保存提示 -->
    <view class="save-hint">
      <text>修改后点击其他地方或输入完毕即可自动保存</text>
    </view>
  </block>
</view>
