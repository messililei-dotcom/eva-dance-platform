.detail-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
}

.detail-page-with-actions {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.detail-overview {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 24rpx;
}

.cover {
  flex: 0 0 204rpx;
  height: 153rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9eaea;
  color: #9f1d20;
}

.cover image {
  display: block;
  width: 100%;
  height: 100%;
}

.cover-text {
  padding: 0 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.info {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow-wrap: break-word;
}

.subtitle,
.stats,
.lesson-count,
.lesson-meta {
  color: #616773;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
}

.subtitle,
.stats {
  margin-top: 6rpx;
}

.stats,
.lesson-count,
.lesson-meta,
.lesson-num {
  font-variant-numeric: tabular-nums;
}

.detail-unlocked,
.access-pending {
  margin-top: 12rpx;
}

.access-pending {
  color: #616773;
  font-size: 24rpx;
}

.detail-retry {
  width: fit-content;
  min-height: 76rpx;
  color: #9f1d20;
  font-size: 26rpx;
  font-weight: 600;
}

.empty .detail-retry {
  margin: 8rpx auto 0;
}

.detail-section {
  margin-top: 20rpx;
}

.intro-card {
  padding: 24rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.desc {
  margin-top: 10rpx;
  color: #42454b;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: break-word;
}

.lesson-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
}

.lesson-list {
  overflow: hidden;
}

.lesson {
  border-top: 1rpx solid #ececef;
}

.lesson-trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100% !important;
  min-height: 104rpx;
  margin: 0;
  padding: 18rpx 24rpx;
  color: inherit;
  text-align: left;
}

.lesson-pressed {
  background: #f6f6f6;
}

.lesson-num {
  flex: 0 0 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #616773;
  background: #f3f4f6;
  font-size: 23rpx;
  font-weight: 600;
}

.lesson-main {
  flex: 1;
  min-width: 0;
}

.lesson-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: break-word;
}

.lesson-meta {
  margin-top: 4rpx;
}

.lesson-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-right: 3rpx;
  color: #9f1d20;
  font-size: 24rpx;
  font-weight: 600;
}

.lesson-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: translateY(-3rpx) rotate(45deg);
}

.lesson-chevron-up {
  transform: translateY(3rpx) rotate(225deg);
}

.lesson-chevron-right {
  transform: rotate(-45deg);
}

.lesson-details {
  margin: 0 24rpx 18rpx 88rpx;
  padding: 12rpx 18rpx;
  border-radius: 10rpx;
  background: #f6f6f6;
  color: #42454b;
  font-size: 26rpx;
  line-height: 1.6;
  overflow-wrap: break-word;
}

.lesson-description {
  white-space: pre-wrap;
}

.lesson-description + .lesson-detail-row,
.lesson-detail-row + .lesson-detail-row {
  margin-top: 6rpx;
}

.bottom-bar {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ececef;
  background: #ffffff;
}

.bottom-bar .primary-btn {
  width: 100% !important;
}
