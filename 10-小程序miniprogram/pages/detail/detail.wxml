<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}"><template is="publicSharePreview" data="{{card:sharePreview}}" /></block>
<block wx:else>
<view wx:if="{{loadError}}" class="page"><view class="empty card">{{loadError}}<button bindtap="retryDetail">重新加载</button></view></view>
<block wx:else>
<view class="page detail-page">
  <view class="hero-card card">
    <view class="cover">
      <image wx:if="{{series.cover_image}}" src="{{series.cover_image}}" mode="aspectFill" binderror="onImageError" data-path="series.cover_image"></image>
      <view wx:else class="cover-text">{{series.category || '伊娃东方舞'}}</view>
    </view>

    <view class="info">
      <view class="title">{{series.name}}</view>
      <view class="subtitle">{{series.subtitle || series.teacher}}</view>
      <view class="stats">
        <text>{{series.total_courses || courses.length}} 项内容</text>
        <text>持续更新</text>
        <text>{{series.popularityText}}</text>
      </view>
      <view wx:if="{{series.accessPending}}">学习权益暂无法确认<button bindtap="retryDetail">重新查询</button></view><view wx:elif="{{series.unlocked}}" class="course-unlocked">✓ 已解锁</view><view wx:else class="course-pricing"><text class="course-sale-price">{{series.hasDiscount ? '优惠价 ' : ''}}{{series.priceText}}</text><text wx:if="{{series.hasDiscount}}" class="course-original-price">原价 {{series.originalPriceText}}</text></view>
      <view wx:if="{{videoPlaybackEnabled && authorized}}" class="auth ok">已确认用户可播放完整内容</view>
    </view>
  </view>

  <view class="panel card">
    <view class="panel-title">内容介绍</view>
    <view class="desc">{{series.description || '伊娃东方舞内容展示，呈现东方舞美学、舞台表达与作品风格。'}}</view>

  </view>

  <view class="lesson-list">
    <view class="panel-title">课程目录</view>
    <view wx:if="{{courses.length}}">
      <view class="lesson card" wx:for="{{courses}}" wx:key="id" bindtap="{{videoPlaybackEnabled ? 'openCourse' : ''}}" data-index="{{index}}">
        <view class="lesson-num">{{index + 1}}</view>
        <view class="lesson-main">
          <view class="lesson-title">{{item.name}}</view>
          <view class="lesson-meta">{{item.durationText + ' · ' + (item.videos.length || item.video_count || 0) + ' 个内容'}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty card">内容正在整理中。</view>
  </view>

  <view wx:if="{{!series.accessPending && (videoPlaybackEnabled || (!authorized && series.canPurchase))}}" class="bottom-bar">
    <view class="bottom-price">{{series.unlocked ? '✓ 已解锁' : series.priceText}}</view>
    <button class="primary-btn" bindtap="primaryAction">{{series.unlocked ? '继续学习' : !authorized && series.canPurchase ? '立即购买' : '立即学习'}}</button>
  </view>
</view>

</block>

</block>
