<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}">
  <template is="publicSharePreview" data="{{card:sharePreview}}" />
</block>
<view wx:elif="{{loadError}}" class="page">
  <view class="empty card">
    {{loadError}}
    <button class="detail-retry" bindtap="retryDetail">重新加载</button>
  </view>
</view>
<view wx:elif="{{series.name}}" class="page detail-page {{!series.accessPending && (videoPlaybackEnabled || (!authorized && series.canPurchase)) ? 'detail-page-with-actions' : ''}}">
  <view class="detail-overview card">
    <view class="cover">
      <image wx:if="{{series.cover_image}}" src="{{series.cover_image}}" mode="aspectFill" binderror="onImageError" data-path="series.cover_image" />
      <text wx:else class="cover-text">{{series.category || '伊娃东方舞'}}</text>
    </view>
    <view class="info">
      <view class="title">{{series.name}}</view>
      <view wx:if="{{series.subtitle || series.teacher}}" class="subtitle">{{series.subtitle || series.teacher}}</view>
      <view wx:if="{{series.popularityText}}" class="stats">{{series.popularityText}}</view>
      <view wx:if="{{series.accessPending}}" class="access-pending">
        <text>学习权益暂无法确认</text>
        <button class="detail-retry" bindtap="retryDetail">重新查询</button>
      </view>
      <view wx:elif="{{series.unlocked}}" class="course-unlocked detail-unlocked">✓ 已解锁</view>
      <view wx:else class="course-pricing">
        <text class="course-sale-price">{{series.hasDiscount ? '优惠价 ' : ''}}{{series.priceText}}</text>
        <text wx:if="{{series.hasDiscount}}" class="course-original-price">原价 {{series.originalPriceText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{series.description}}" class="detail-section intro-card card">
    <view class="panel-title">内容介绍</view>
    <view class="desc">{{series.description}}</view>
  </view>

  <view class="detail-section lesson-list card">
    <view class="lesson-heading">
      <view class="panel-title">内容目录</view>
      <text wx:if="{{courses.length}}" class="lesson-count">共 {{courses.length}} 节</text>
    </view>
    <view wx:if="{{courses.length}}">
      <view class="lesson" wx:for="{{courses}}" wx:key="id">
        <button class="lesson-trigger" hover-class="lesson-pressed" bindtap="openCourse" data-index="{{index}}" aria-expanded="{{expandedLessonIndex === index}}" aria-label="{{item.name}}，{{expandedLessonIndex === index ? '收起分节信息' : videoPlaybackEnabled && item.canPlay ? '观看分节' : '展开分节信息'}}">
          <view class="lesson-num">{{index + 1}}</view>
          <view class="lesson-main">
            <view class="lesson-title">{{item.name}}</view>
            <view class="lesson-meta">{{item.durationText}}<text wx:if="{{item.videos.length || item.video_count}}"> · {{item.videos.length || item.video_count}} 个内容</text></view>
          </view>
          <view class="lesson-action">
            <text>{{expandedLessonIndex === index ? '收起' : videoPlaybackEnabled && item.canPlay ? '查看' : '分节信息'}}</text>
            <view class="lesson-chevron {{expandedLessonIndex === index ? 'lesson-chevron-up' : videoPlaybackEnabled && item.canPlay ? 'lesson-chevron-right' : ''}}"></view>
          </view>
        </button>
        <view wx:if="{{expandedLessonIndex === index}}" class="lesson-details">
          <view wx:if="{{item.lessonDescription}}" class="lesson-description">{{item.lessonDescription}}</view>
          <view wx:for="{{item.videos}}" wx:for-item="clip" wx:key="id" class="lesson-detail-row">{{clip.name || item.name}}</view>
          <view wx:if="{{!item.lessonDescription && !item.videos.length}}" class="lesson-detail-row">分节时长：{{item.durationText}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty">内容正在整理中。</view>
  </view>

  <view wx:if="{{!series.accessPending && (videoPlaybackEnabled || (!authorized && series.canPurchase))}}" class="bottom-bar">
    <button class="primary-btn" bindtap="primaryAction">{{series.unlocked ? '继续学习' : !authorized && series.canPurchase ? '立即购买' : '立即学习'}}</button>
  </view>
</view>
