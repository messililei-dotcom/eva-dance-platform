/* Content-first academy; the course source and permission gates stay in JS. */
.page{min-height:100vh;padding:32rpx;background:#f6f7f9;color:#202124}
.academy-title{font-size:44rpx;font-weight:700;line-height:1.3}.academy-desc{margin-top:12rpx;font-size:26rpx;line-height:1.6;color:#616773}
.learning-links{display:flex;gap:16rpx;margin:28rpx 0 36rpx}.learning-links button{flex:1;min-width:0;min-height:128rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;background:#fff;border-radius:24rpx;color:#9f1d20;font-size:24rpx}.learning-links image{width:40rpx;height:40rpx}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-bottom:20rpx}.section-kicker{font-size:34rpx;font-weight:700}.list-actions{display:flex;align-items:center;gap:12rpx}.all-btn{padding:16rpx 18rpx;color:#9f1d20;background:#f9eaea;border-radius:16rpx;font-size:26rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center}
.list-head{flex-wrap:wrap}.list-head>view:first-child{flex:1}.section-head>.list-actions{display:contents}.inline-search{order:3;width:100%;display:flex;align-items:center;min-height:88rpx;border:1rpx solid #d9dde3;border-radius:24rpx;background:#fff;padding:0 16rpx}.search-input{flex:1;min-width:0;height:88rpx;font-size:28rpx;color:#202124}.search-clear-btn{min-width:88rpx;min-height:88rpx;color:#616773;font-size:34rpx}.search-icon-btn{width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center}.search-icon{position:relative;width:28rpx;height:28rpx;border:3rpx solid #616773;border-radius:50%}.search-icon::after{position:absolute;right:-10rpx;bottom:-6rpx;width:15rpx;height:3rpx;background:#616773;content:"";transform:rotate(45deg)}
.search-result{margin:8rpx 0 20rpx;color:#616773;font-size:26rpx}.course-list{display:flex;flex-direction:column;gap:20rpx}.course-row{display:flex;align-items:center;gap:24rpx;background:#fff;border-radius:24rpx;padding:24rpx;min-width:0}.row-cover{width:196rpx;height:184rpx;flex-shrink:0;overflow:hidden;border-radius:20rpx;background:#f9eaea}.row-cover image{width:100%;height:100%;display:block}.cover-fallback{height:100%;display:flex;align-items:center;justify-content:center;color:#9f1d20;font-size:28rpx}.row-body{flex:1;min-width:0}.row-badge{color:#9f1d20;font-size:23rpx}.row-title{margin-top:8rpx;color:#202124;font-size:30rpx;line-height:1.45;font-weight:600}.row-teacher{margin-top:8rpx;color:#616773;font-size:24rpx;line-height:1.5}.row-meta{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx;color:#616773;font-size:24rpx;line-height:1.4}.empty-card{padding:48rpx 24rpx;display:flex;flex-direction:column;align-items:center;gap:24rpx;background:#fff;border-radius:24rpx;color:#616773;font-size:28rpx;line-height:1.6;text-align:center}.bottom-all-btn{min-height:96rpx;margin-top:28rpx;display:flex;align-items:center;justify-content:center;background:#9f1d20;color:#fff;border-radius:24rpx;font-size:28rpx}
@media(min-width:700px){.page{max-width:1040rpx;margin:0 auto}.course-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.row-cover{width:160rpx;height:160rpx}}
