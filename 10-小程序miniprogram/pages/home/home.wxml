<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}"><template is="publicSharePreview" data="{{card:sharePreview}}" /></block>
<block wx:else>
<view class="page">
  <view class="academy-intro"><view class="academy-title">伊娃东方舞</view><view class="academy-desc">线上学院 · 从基础到进阶，找到适合你的课程</view></view>
  <view class="learning-links">
    <button bindtap="goMyCourses"><image src="/images/profile/book.svg"/><text>我的课程</text></button>
    <button bindtap="goOffline"><image src="/images/profile/calendar.svg"/><text>课时与核销</text></button>
    <button bindtap="goEvents"><image src="/images/profile/award.svg"/><text>报名与成绩</text></button>
  </view>
  <view class="section-head list-head">
    <view>
      <text class="section-kicker">课程列表</text>
    </view>
    <view class="list-actions">
      <button class="all-btn" bindtap="goSystemCourses">全部课程</button>
      <view class="inline-search {{searchKeyword ? 'has-keyword' : ''}}">
        <input
          class="search-input"
          value="{{searchKeyword}}"
          placeholder="搜索课程、老师或分类"
          confirm-type="search"
          focus="{{searchFocused}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <button wx:if="{{searchKeyword}}" class="search-clear-btn" aria-label="清空搜索" bindtap="onClearSearch">×</button>
        <button class="search-icon-btn" aria-label="搜索" bindtap="onSearchButtonTap">
          <view class="search-icon"></view>
        </button>
      </view>
    </view>
  </view>
  <view class="search-result" wx:if="{{searchCountText}}">{{searchCountText}}</view>

  <view wx:if="{{loading}}" class="empty-card">课程加载中…</view>
  <view wx:elif="{{error}}" class="empty-card"><text>{{error}}</text><button class="all-btn" bindtap="loadHomeSections">重新加载</button></view>
  <view class="course-list" wx:elif="{{courseRows.length}}">
    <view class="course-row" wx:for="{{courseRows}}" wx:key="id" bindtap="goCard" data-id="{{item.id}}" data-source="{{item.sourceType}}">
      <view class="row-cover">
        <image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" binderror="onImageError" data-path="courseRows[{{index}}].cover_image"></image>
        <view wx:else class="cover-fallback">课程</view>
      </view>
      <view class="row-body">
        <view class="row-badge">{{item.badge}}</view>
        <view class="row-title">{{item.title}}</view><view class="row-teacher">{{item.meta}}</view>
<view class="row-meta">
          <text>{{item.lessonText}}</text>
          <text>{{item.popularityText}}</text>
        </view>
        <view wx:if="{{item.unlocked}}" class="course-unlocked">✓ 已解锁 <text class="course-learn-action">继续学习</text></view><view wx:else class="course-pricing"><text class="course-sale-price">{{item.hasDiscount ? '优惠价 ' : ''}}{{item.priceText}}</text><text wx:if="{{item.hasDiscount}}" class="course-original-price">原价 {{item.originalPriceText}}</text></view>
      </view>
    </view>
  </view>
  <view wx:else class="empty-card">{{searchKeyword ? '没有找到相关课程，请换个关键词' : '课程即将更新，稍后再来看看'}}</view>

  <button class="bottom-all-btn" bindtap="goSystemCourses">查看全部课程</button>
</view>

</block>
