.detail-page{min-height:100vh;padding:20rpx 20rpx 150rpx;background:#f8f3ea}.course-cover{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border-radius:24rpx 24rpx 0 0;background:#2c1810}.course-cover image,.cover-fallback{width:100%;height:100%}.cover-fallback{display:flex;align-items:center;justify-content:center;color:#e2c88e;background:linear-gradient(135deg,#4a2419,#9f1d20);font-size:42rpx;font-weight:900}.cover-shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 36%,rgba(26,16,12,.86))}.cover-title{position:absolute;left:24rpx;right:24rpx;bottom:24rpx;color:#fff;font-size:36rpx;line-height:1.35;font-weight:900}.course-info{padding:24rpx;border:1rpx solid #eadfcf;border-top:0;border-radius:0 0 24rpx 24rpx;background:#fff}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.info-grid view{padding:16rpx;border-radius:14rpx;background:#f8f3ea}.info-grid text,.info-grid span{display:block}.info-grid text{color:#8a7a68;font-size:19rpx}.info-grid span{margin-top:6rpx;color:#2c1810;font-size:23rpx;font-weight:800}.info-grid .price{color:#9f1d20}.description-title{margin-top:24rpx;color:#2c1810;font-size:30rpx;font-weight:900}.description{margin-top:12rpx;color:#6f6257;font-size:24rpx;line-height:1.75;white-space:pre-wrap}.period-section{margin-top:18rpx}.period-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx;padding:0 4rpx}.period-head view{color:#2c1810;font-size:30rpx;font-weight:900}.period-head text{color:#8a7a68;font-size:20rpx}.period-list{display:grid;gap:12rpx}.period-card{padding:20rpx;border:1rpx solid #eadfcf;border-radius:18rpx;background:#fff}.period-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.period-top>view{min-width:0}.period-top b,.period-top text{display:block}.period-top b{color:#2c1810;font-size:26rpx;line-height:1.4}.period-top text{margin-top:5rpx;color:#8a7a68;font-size:19rpx}.period-top>span{flex:0 0 auto;color:#9f1d20;font-size:24rpx;font-weight:900}.period-meta{display:flex;gap:18rpx;margin-top:12rpx;color:#7c6e5f;font-size:21rpx}.period-desc{margin-top:12rpx;padding-top:12rpx;border-top:1rpx solid #f1e7d8;color:#6f6257;font-size:21rpx;line-height:1.6}.action-bar{position:fixed;left:20rpx;right:20rpx;bottom:24rpx;display:grid;grid-template-columns:1.25fr .75fr;gap:12rpx;padding:12rpx;border:1rpx solid #eadfcf;border-radius:18rpx;background:rgba(255,255,255,.96);box-shadow:0 10rpx 30rpx rgba(44,24,16,.12)}.action-bar button{height:78rpx;border-radius:13rpx;font-size:24rpx;font-weight:900;line-height:78rpx}.action-bar button::after{border:0}.schedule-btn{color:#fff;background:#9f1d20}.contact-btn{color:#8a6a32;background:#f8f3ea}.empty-card{padding:74rpx 22rpx;border:1rpx solid #eadfcf;border-radius:20rpx;color:#8a7a68;background:#fff;text-align:center;font-size:24rpx}
