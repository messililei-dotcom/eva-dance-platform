<view class="detail-page">
  <view wx:if="{{loading}}" class="empty-card">课程加载中…</view>
  <block wx:else>
    <view class="course-cover">
      <image wx:if="{{course.coverImage}}" src="{{course.coverImage}}" mode="aspectFill" binderror="onImageError"></image>
      <view wx:else class="cover-fallback">线下课</view>
      <view class="cover-shade"></view>
      <view class="cover-title">{{course.name}}</view>
    </view>

    <view class="course-info">
      <view class="info-grid">
        <view><text>授课老师</text><span>{{course.teacherText}}</span></view>
        <view><text>开设期次</text><span>{{course.sessionsText}}</span></view>
        <view><text>最新期次</text><span>{{course.dateText}}</span></view>
        <view><text>课程费用</text><span class="price">{{course.priceText}}</span></view>
      </view>
      <view class="description-title">课程介绍</view>
      <view class="description">{{course.descriptionText}}</view>
    </view>

    <view class="period-section">
      <view class="period-head">
        <view>课程期次</view>
        <text>共 {{course.periodCount}} 期</text>
      </view>
      <view class="period-list">
        <view class="period-card" wx:for="{{course.periods}}" wx:key="id">
          <view class="period-top">
            <view>
              <b>{{item.subtitle && item.subtitle !== 'offline' ? item.subtitle : item.dateText}}</b>
              <text>{{item.dateText}}</text>
            </view>
            <span>{{item.priceText}}</span>
          </view>
          <view class="period-meta">
            <text>{{item.teacherText}}</text>
            <text>{{item.sessionsText}}</text>
          </view>
          <view wx:if="{{item.descriptionText}}" class="period-desc">{{item.descriptionText}}</view>
        </view>
      </view>
    </view>

    <view class="action-bar">
      <button class="schedule-btn" bindtap="openSchedule">查看课表并约课</button>
      <button class="contact-btn" open-type="contact" show-message-card="true" send-message-title="{{course.name}}" send-message-path="/pages/offline-detail/offline-detail?id={{course.id}}">预约咨询</button>
    </view>
  </block>
</view>
