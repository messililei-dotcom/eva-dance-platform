.tab-scroll {
  width: 100%;
  margin-top: 6rpx;
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  gap: 14rpx;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 146rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #6d655e;
  background: #ffffff;
  border: 1rpx solid rgba(32, 33, 36, 0.06);
  font-size: 26rpx;
  font-weight: 800;
}

.filter-tab.active {
  color: #ffffff;
  background: #9f1d20;
}

.course-count {
  margin: 28rpx 0 8rpx;
  color: #8c8172;
  font-size: 25rpx;
}

.system-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.system-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 22rpx;
  padding: 22rpx;
}

.cover {
  position: relative;
  width: 100%;
  height: 220rpx;
  aspect-ratio: 4 / 3;
  border-radius: 12rpx;
  overflow: hidden;
  display: grid;
  place-items: center;
  color: #ffffff;
  background: linear-gradient(135deg, #2d3541, #b56a48);
  font-size: 28rpx;
  font-weight: 900;
}

.cover image {
  width: 100%;
  height: 100%;
}

.badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.42);
  font-size: 22rpx;
  font-weight: 800;
}

.course-main {
  min-width: 0;
}

.course-name {
  color: #202124;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 900;
}

.course-subtitle {
  margin-top: 10rpx;
  color: #82786f;
  font-size: 25rpx;
  line-height: 1.4;
}

.course-meta {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.course-meta text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #706861;
  background: #f6eee6;
  font-size: 23rpx;
}

.course-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.course-bottom .ghost-btn {
  min-width: 156rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  font-size: 25rpx;
}

.page{padding:20rpx 28rpx 40rpx;background:#fff;min-height:100vh;box-sizing:border-box}
.system-list{display:flex;flex-direction:column;gap:0}.system-card{display:flex;align-items:center;gap:20rpx;padding:20rpx 0;border:0;border-bottom:1rpx solid #eceff3;border-radius:0;box-shadow:none;background:transparent}
.cover{width:224rpx;height:192rpx;flex-shrink:0;aspect-ratio:auto;border-radius:8rpx;background:transparent}.cover image{display:block;padding:0;border:0}.badge{max-width:180rpx;white-space:normal;font-size:22rpx}.course-main{flex:1}.course-name{font-size:30rpx;font-weight:600}.course-count{margin:16rpx 0 0}.filter-tab{min-height:88rpx;height:auto;border-radius:12rpx}.tab-row{gap:12rpx}.tab-scroll{margin-top:12rpx}
