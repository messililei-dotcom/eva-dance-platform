<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}"><template is="publicSharePreview" data="{{card:sharePreview}}" /></block>
<block wx:else>
<view class="page">
  <view class="catalog-search"><input value="{{searchKeyword}}" placeholder="搜索课程、老师或分类" aria-label="搜索课程" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchConfirm"/><button wx:if="{{searchKeyword}}" aria-label="清空搜索" bindtap="onClearSearch">×</button></view>
  <button class="catalog-chip {{unlockedOnly ? 'selected' : ''}}" bindtap="toggleUnlocked" aria-pressed="{{unlockedOnly}}">✓ 已解锁</button>
  <scroll-view class="tab-scroll" scroll-x>
    <view class="tab-row">
      <view
        class="filter-tab {{activeTab === item.key ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        bindtap="switchTab"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="course-count">共 {{courses.length}} 个内容</view>

  <view wx:if="{{loading}}" class="empty">课程加载中…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button bindtap="loadCourses">重新加载</button></view>
  <view class="system-list" wx:elif="{{courses.length}}">
    <view class="system-card card" hover-class="row-pressed" hover-stay-time="80" wx:for="{{courses}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="cover">
        <image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" binderror="onImageError" data-path="courses[{{index}}].cover_image"></image>
        <text wx:else>{{item.badge}}</text>
        <view class="badge">{{item.badge}}</view>
      </view>
      <view class="course-main">
        <view class="course-name">{{item.name}}</view>
        <view class="course-subtitle">{{item.subtitle || item.teacher || '伊娃东方舞内容展示'}}</view>
        <view class="course-meta">
          <text>{{item.lessonText}}</text>
          <text>{{item.learnerText}}</text>
        </view>
        <view wx:if="{{item.unlocked}}" class="course-unlocked">✓ 已解锁 <text class="course-learn-action">{{videoPlaybackEnabled ? '继续学习' : '查看课程'}}</text></view><view wx:else class="course-pricing"><text class="course-sale-price">{{item.hasDiscount ? '优惠价 ' : ''}}{{item.priceText}}</text><text wx:if="{{item.hasDiscount}}" class="course-original-price">原价 {{item.originalPriceText}}</text></view>
      </view>
    </view>
  </view>

  <view wx:else class="empty card">暂无相关内容，请切换分类查看。</view>
</view>

</block>
