<view class="page">
  <scroll-view class="tab-scroll" scroll-x>
    <view class="tab-row">
      <view
        class="filter-tab {{activeTab === item.key ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        bindtap="switchTab"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="course-count">共 {{courses.length}} 个内容</view>

  <view class="system-list" wx:if="{{courses.length}}">
    <view class="system-card card" wx:for="{{courses}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="cover">
        <image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" binderror="onImageError" data-path="courses[{{index}}].cover_image"></image>
        <text wx:else>{{item.badge}}</text>
        <view class="badge">{{item.badge}}</view>
      </view>
      <view class="course-main">
        <view class="course-name">{{item.name}}</view>
        <view class="course-subtitle">{{item.subtitle || item.teacher || '伊娃东方舞内容展示'}}</view>
        <view class="course-meta">
          <text>{{item.lessonText}}</text>
          <text>{{item.learnerText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty card">暂无相关内容，请切换分类查看。</view>
</view>
