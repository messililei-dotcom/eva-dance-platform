.group-page{min-height:100vh;padding:20rpx 20rpx 48rpx;background:#f8f3ea}.group-hero{padding:30rpx;border-radius:24rpx;color:#fff;background:#1a1a1a;box-shadow:0 12rpx 30rpx rgba(44,24,16,.12)}.event-name{color:#c8a96e;font-size:21rpx;font-weight:800}.group-name{margin-top:16rpx;font-size:39rpx;line-height:1.3;font-weight:900}.group-tags{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:18rpx;color:rgba(255,255,255,.65);font-size:22rpx}.group-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:20rpx;margin-top:28rpx;padding-top:22rpx;border-top:1rpx solid rgba(255,255,255,.1)}.group-stats text,.group-stats span{display:block}.group-stats text{color:#c8a96e;font-size:38rpx;font-weight:900}.group-stats span{margin-top:6rpx;color:rgba(255,255,255,.55);font-size:20rpx}.result-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin:30rpx 4rpx 18rpx}.result-title{color:#2c1810;font-size:35rpx;font-weight:900}.result-desc{margin-top:6rpx;color:#8a7a68;font-size:21rpx}.result-heading>text{color:#8a7a68;font-size:22rpx}.player-list{display:grid;gap:12rpx}.player-row{display:grid;grid-template-columns:58rpx 72rpx minmax(0,1fr);align-items:center;gap:12rpx;min-height:116rpx;padding:14rpx;border:1rpx solid #eadfce;border-radius:18rpx;background:#fff;box-shadow:0 5rpx 14rpx rgba(44,24,16,.04)}.player-row.ranking-row{grid-template-columns:70rpx 72rpx minmax(0,1fr) 86rpx}.rank-block{text-align:center}.trophy{font-size:34rpx;line-height:1}.rank-block.silver .trophy{filter:grayscale(1);opacity:.65}.rank-block.bronze .trophy{filter:sepia(1);opacity:.78}.rank-block.normal .trophy{opacity:.5}.rank-number{font-size:28rpx;font-weight:900}.rank-block text{display:block;margin-top:5rpx;color:#8a7a68;font-size:17rpx}.rank-block.gold text{color:#b37600}.rank-block.silver text{color:#7d858f}.rank-block.bronze text{color:#a45c2b}.player-number{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:50%;color:#8a6a32;background:#f8f3ea;font-size:21rpx;font-weight:900}.player-avatar{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;overflow:hidden;border-radius:50%;color:#fff;background:linear-gradient(135deg,#8b1a1a,#b99652);font-size:25rpx;font-weight:900}.player-avatar image{width:100%;height:100%}.player-main{min-width:0}.player-name{overflow:hidden;color:#2c1810;font-size:27rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.player-meta{margin-top:7rpx;overflow:hidden;color:#8a7a68;font-size:19rpx;text-overflow:ellipsis;white-space:nowrap}.score-block{text-align:right}.score-block view{color:#9f1d20;font-size:28rpx;font-weight:900}.score-block text{display:block;margin-top:5rpx;color:#8a7a68;font-size:16rpx}.empty-card{padding:74rpx 22rpx;border:1rpx solid #eadfce;border-radius:20rpx;color:#8a7a68;background:#fff;text-align:center;font-size:24rpx}
