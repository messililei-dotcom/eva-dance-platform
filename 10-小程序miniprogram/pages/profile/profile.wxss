.profile-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 34rpx 212rpx 18rpx 8rpx;
}

.avatar {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #ff5b45;
  font-size: 38rpx;
  font-weight: 800;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(255, 91, 69, 0.16);
}

.avatar-img {
  display: block;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone {
  margin-top: 8rpx;
  color: #8c8172;
  font-size: 26rpx;
}

.wechat-card {
  padding: 24rpx;
}

.wechat-copy {
  margin-bottom: 18rpx;
}

.wechat-title {
  color: #202124;
  font-size: 31rpx;
  font-weight: 900;
}

.wechat-desc {
  margin-top: 8rpx;
  color: #8c8172;
  font-size: 25rpx;
  line-height: 1.45;
}

.wechat-form {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wechat-profile-row {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
}

.avatar-picker {
  width: 104rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #ff5b45;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 104rpx;
  text-align: center;
  overflow: hidden;
}

.avatar-picker::after {
  border: 0;
}

.avatar-picker-img {
  display: block;
  width: 104rpx;
  height: 104rpx;
}

.wechat-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #f0e6da;
  border-radius: 14rpx;
  background: #fffaf4;
  color: #202124;
  font-size: 27rpx;
}

.sync-btn {
  width: 100%;
  height: 76rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #ff5b45;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.sync-btn::after {
  border: 0;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 8rpx;
  text-align: center;
}

.num {
  display: block;
  color: #ff5b45;
  font-size: 38rpx;
  font-weight: 800;
}

.level-num {
  min-height: 50rpx;
  padding: 0 8rpx;
  font-size: 28rpx;
  line-height: 50rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.label {
  display: block;
  margin-top: 8rpx;
  color: #8c8172;
  font-size: 24rpx;
}

.section-title {
  margin-bottom: 14rpx;
  color: #202124;
  font-size: 32rpx;
  font-weight: 900;
}

.progress-list {
  overflow: hidden;
}

.progress-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0e6da;
}

.progress-item:last-child {
  border-bottom: 0;
}

.progress-title {
  color: #202124;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
}

.progress-sub {
  margin-top: 6rpx;
  color: #8c8172;
  font-size: 23rpx;
  line-height: 1.35;
}

.detail-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 20rpx 26rpx;
}

.detail-toggle-title {
  color: #202124;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.detail-toggle-desc {
  margin-top: 7rpx;
  color: #8c8172;
  font-size: 24rpx;
  line-height: 1.35;
}

.detail-toggle-action {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #ff5b45;
  background: #fff2ef;
  font-size: 24rpx;
  font-weight: 900;
}

.detail-edit {
  margin-top: 16rpx;
  padding: 4rpx 24rpx 24rpx;
}

.detail-field {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f0e6da;
}

.detail-field:last-of-type {
  border-bottom: 0;
}

.detail-label {
  color: #202124;
  font-size: 26rpx;
  font-weight: 800;
}

.detail-input {
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  color: #3e4652;
  background: #fffaf4;
  font-size: 26rpx;
  text-align: right;
}

.detail-save-btn {
  height: 78rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ff5b45;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.certificate-list {
  overflow: hidden;
}

.certificate-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f0e6da;
}

.certificate-item:last-child {
  border-bottom: 0;
}

.certificate-main {
  min-width: 0;
  flex: 1;
}

.certificate-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.certificate-sub {
  margin-top: 8rpx;
  color: #8c8172;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-all;
}

.certificate-empty {
  padding: 36rpx 28rpx;
  color: #8c8172;
  font-size: 26rpx;
  text-align: center;
}

.menu {
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f0e6da;
  font-size: 30rpx;
  font-weight: 700;
}

button.menu-item {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  border-radius: 0;
  background: #ffffff;
  color: #202124;
  line-height: 1.2;
  text-align: left;
}

button.menu-item::after {
  border: 0;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-value {
  max-width: 360rpx;
  color: #8c8172;
  font-size: 25rpx;
  font-weight: 500;
  text-align: right;
}

.admin-item {
  color: #ffffff;
  background: linear-gradient(135deg, #2c3440, #b65f42);
}

.admin-item .menu-value {
  color: rgba(255, 255, 255, 0.78);
}

/* 登录/退出按钮 */
.profile-head {
  position: relative;
}

.auth-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #C8A96E, #8B1A1A);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 24rpx;
}

.profile-actions {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bind-phone-btn,
.bind-wechat-btn,
.logout-btn {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 24rpx;
  white-space: nowrap;
}

.bind-phone-btn,
.bind-wechat-btn {
  background: #1aad19;
  color: #ffffff;
}

.logout-btn {
  background: #f5f5f5;
  color: #999;
}

