.profile-page {
  min-height: 100vh;
  padding: 0 22rpx 38rpx;
  background: #f8f3ea;
}

.profile-shell {
  overflow: hidden;
  border-radius: 22rpx;
  background: #ffffff;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 152rpx;
  padding: 22rpx 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #8b1a1a, #b99652);
}

.avatar,
.avatar-picker {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border-radius: 52rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  font-size: 38rpx;
  font-weight: 900;
}

.avatar-img,
.avatar-picker-img {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.name {
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone {
  margin-top: 8rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.head-action {
  flex: 0 0 auto;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 800;
}

.head-action::after,
.avatar-picker::after,
.sync-btn::after {
  border: 0;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #f1e7d8;
  background: #ffffff;
}

.stat-item {
  text-align: center;
}

.num {
  display: block;
  color: #2c1810;
  font-size: 31rpx;
  font-weight: 900;
}

.label {
  display: block;
  margin-top: 4rpx;
  color: #8a7a68;
  font-size: 21rpx;
}

.bind-card,
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 98rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f1e7d8;
  background: #ffffff;
}

.row-title,
.content-title,
.record-title {
  color: #2c1810;
  font-weight: 900;
}

.row-title {
  font-size: 29rpx;
}

.row-desc {
  margin-top: 6rpx;
  color: #8a7a68;
  font-size: 21rpx;
  line-height: 1.35;
}

.row-arrow {
  flex: 0 0 auto;
  color: #8a6a32;
  font-size: 25rpx;
  font-weight: 800;
}

.wechat-action {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #1aad19;
  font-size: 22rpx;
  font-weight: 800;
}

.wechat-card {
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f1e7d8;
  background: #ffffff;
}

.wechat-title {
  color: #2c1810;
  font-size: 29rpx;
  font-weight: 900;
}

.wechat-desc {
  margin-top: 5rpx;
  color: #8a7a68;
  font-size: 21rpx;
}

.wechat-profile-row {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.avatar-picker {
  margin: 0;
  padding: 0;
  line-height: 104rpx;
}

.wechat-input {
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e8ddcb;
  border-radius: 16rpx;
  color: #2c1810;
  background: #ffffff;
  font-size: 25rpx;
}

.sync-btn {
  width: 100%;
  height: 72rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #9f1d20;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.content-section {
  padding: 18rpx 18rpx 20rpx;
  border-top: 1rpx solid #f1e7d8;
  background: #ffffff;
}

.content-title {
  margin: 0 4rpx 14rpx;
  font-size: 31rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.schedule-link {
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #9f1d20;
  font-size: 21rpx;
  font-weight: 800;
}

.schedule-link::after {
  border: 0;
}

.online-course {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 124rpx;
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #fbf8f2;
}

.course-cover {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 114rpx;
  overflow: hidden;
  border-radius: 14rpx;
}

.course-fallback {
  color: #ffffff;
  background: linear-gradient(135deg, #8b1a1a, #b99652);
  font-size: 28rpx;
  font-weight: 900;
}

.course-main {
  min-width: 0;
  flex: 1;
}

.course-name {
  display: -webkit-box;
  overflow: hidden;
  color: #2c1810;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.course-meta,
.record-meta {
  margin-top: 8rpx;
  color: #8a7a68;
  font-size: 21rpx;
  line-height: 1.45;
}

.record-card {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #fbf8f2;
}

.record-title {
  font-size: 27rpx;
  line-height: 1.35;
}

.event-record {
  position: relative;
  padding-right: 42rpx;
}

.event-record::after {
  position: absolute;
  top: 50%;
  right: 18rpx;
  color: #8a6a32;
  content: "›";
  font-size: 26rpx;
  transform: translateY(-50%);
}

.certificate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #fbf8f2;
}

.certificate-action {
  flex: 0 0 auto;
  color: #9f1d20;
  font-size: 23rpx;
  font-weight: 900;
}

.empty-row {
  padding: 24rpx 18rpx;
  border-radius: 18rpx;
  color: #8a7a68;
  background: #f8f3ea;
  font-size: 23rpx;
}

.admin-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  color: #ffffff;
  background: #2c1810;
  font-size: 25rpx;
  font-weight: 800;
}

.connection-card{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:18rpx 0;padding:20rpx 22rpx;border:1rpx solid #ead8c2;border-radius:18rpx;background:#fff8ee}.connection-card>view{min-width:0;flex:1}.connection-card button{height:60rpx;margin:0;padding:0 20rpx;border-radius:999rpx;color:#fff;background:#9f1d20;font-size:22rpx;line-height:60rpx;font-weight:800}.connection-card button::after{border:0}
