<view class="profile-page">
  <view class="profile-shell">
    <view class="profile-head">
      <view class="avatar" wx:if="{{isLoggedIn}}">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        <text wx:else>{{displayInitial}}</text>
      </view>
      <view class="avatar" wx:else>伊</view>
      <view class="profile-main">
        <view class="name">{{wechatName || memberName}}</view>
        <view class="phone">{{isLoggedIn ? memberLevelText + ' · ' + (memberPhone || '未绑定手机号') : '登录后同步官网个人中心数据'}}</view>
      </view>
      <button class="head-action" wx:if="{{!isLoggedIn}}" bindtap="goLogin">登录</button>
      <button class="head-action" wx:else bindtap="logout">退出</button>
    </view>

    <view class="stats">
      <view class="stat-item"><text class="num">{{authorizedCourses.length}}</text><text class="label">线上课</text></view>
      <view class="stat-item"><text class="num">{{offlineCourses.length}}</text><text class="label">线下课</text></view>
      <view class="stat-item"><text class="num">{{eventRegistrations.length}}</text><text class="label">比赛</text></view>
      <view class="stat-item"><text class="num">{{certificates.length}}</text><text class="label">证书</text></view>
    </view>

    <view class="connection-card" wx:if="{{isLoggedIn && (profileLoading || profileError)}}">
      <view><view class="row-title">{{profileLoading ? '正在连接个人中心…' : '个人中心连接失败'}}</view><view class="row-desc" wx:if="{{profileError}}">{{profileError}}</view></view>
      <button wx:if="{{profileError}}" bindtap="reconnectProfile">重新连接</button>
    </view>

    <view class="bind-card" wx:if="{{isLoggedIn && needsPhoneBinding}}" bindtap="goLogin">
      <view>
        <view class="row-title">绑定手机号</view>
        <view class="row-desc">绑定后同步官网课程授权和线下课程资料</view>
      </view>
      <text class="row-arrow">去绑定 ›</text>
    </view>

    <view class="bind-card" wx:if="{{isLoggedIn && !needsPhoneBinding && !isWechatBound}}" bindtap="openWechatBinder">
      <view>
        <view class="row-title">绑定微信，开启双线路登录</view>
        <view class="row-desc">微信和手机号都可作为课程授权匹配依据</view>
      </view>
      <text class="wechat-action">绑定微信</text>
    </view>

    <view class="wechat-card" wx:if="{{isLoggedIn && showWechatBinder}}">
      <view class="wechat-copy">
        <view class="wechat-title">微信资料</view>
        <view class="wechat-desc">{{wechatIdentityText || '微信身份已登录'}}</view>
      </view>
      <view class="wechat-profile-row">
        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" class="avatar-picker-img" src="{{avatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{displayInitial}}</text>
        </button>
        <input class="wechat-input" type="nickname" value="{{wechatNameDraft}}" placeholder="填写微信昵称" bindinput="onWechatNameInput" />
      </view>
      <button class="sync-btn" bindtap="syncWechatProfile">同步微信资料</button>
    </view>

    <view class="link-row" bindtap="openEventRegistrations">
      <view>
        <view class="row-title">我的比赛</view>
        <view class="row-desc">{{eventRegistrations.length}} 个报名组别 · 查看审核、缴费和比赛信息</view>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="link-row" bindtap="goProfileEdit">
      <view>
        <view class="row-title">个人资料</view>
        <view class="row-desc">微信名、头像、手机号、生日和地址</view>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="content-section">
      <view class="content-title">我的线上课程</view>
      <view wx:if="{{authorizedCourses.length}}">
        <view class="online-course" wx:for="{{authorizedCourses}}" wx:key="id" data-id="{{item.id}}" bindtap="openProfileCourse">
          <image wx:if="{{item.cover_image}}" class="course-cover" src="{{item.cover_image}}" mode="aspectFill"></image>
          <view wx:else class="course-cover course-fallback">课</view>
          <view class="course-main">
            <view class="course-name">{{item.name}}</view>
            <view class="course-meta">{{item.total_courses || 0}} 节 · 已学 {{item.progressPercent || 0}}%</view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-row">暂无已授权线上课程</view>
    </view>

    <view class="content-section">
      <view class="section-heading">
        <view class="content-title">我的线下课程</view>
        <button class="schedule-link" bindtap="openOfflineSchedule">去约课</button>
      </view>
      <view wx:if="{{offlineCourses.length}}">
        <view class="record-card" wx:for="{{offlineCourses}}" wx:key="id">
          <view class="record-title">{{item.courseName}}</view>
          <view class="record-meta">{{item.courseSubType ? '期次 ' + item.courseSubType + ' · ' : ''}}缴费日期 {{item.displayDate}} · 实付 {{item.displayAmount}}</view>
          <view class="record-meta">剩余 {{item.remainingSessions}} 课次{{item.consumedSessions ? ' · 已核销 ' + item.consumedSessions + ' 课次' : ''}}{{item.paymentMethod ? ' · ' + item.paymentMethod : ''}}</view>
        </view>
      </view>
      <view wx:else class="empty-row">暂无线下课程记录</view>
    </view>

    <view class="content-section" wx:if="{{eventRegistrations.length}}">
      <view class="content-title">比赛报名</view>
      <view class="record-card event-record" wx:for="{{eventRegistrations}}" wx:key="id" data-id="{{item.competitionId}}" bindtap="openEventRegistration">
        <view class="record-title">{{item.competitionName}}</view>
        <view class="record-meta">{{item.groupName}}{{item.playerNo ? ' · 选手号 ' + item.playerNo : ''}}</view>
        <view class="record-meta">{{item.statusText}}{{item.paidStatusText ? ' · ' + item.paidStatusText : ''}}{{item.displayStartDate ? ' · ' + item.displayStartDate : ''}}</view>
        <view class="record-meta">{{item.resultText}}</view>
      </view>
    </view>

    <view class="content-section">
      <view class="content-title">我的证书</view>
      <view wx:if="{{certificates.length}}">
        <view class="certificate-row" wx:for="{{certificates}}" wx:key="id" bindtap="viewCertificate" data-url="{{item.openUrl}}">
          <view>
            <view class="record-title">{{item.courseName}}</view>
            <view class="record-meta">编号 {{item.certificateNo || '-'}} · {{item.displayIssueDate}}</view>
          </view>
          <text class="certificate-action">{{item.actionText}}</text>
        </view>
      </view>
      <view wx:else class="empty-row">暂无证书</view>
    </view>

    <view class="admin-row" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <text>管理后台</text>
      <text>{{adminRole || '管理员'}} ›</text>
    </view>
  </view>
</view>
