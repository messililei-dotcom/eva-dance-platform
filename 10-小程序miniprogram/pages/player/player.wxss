t-size:30rpx;font-weight:900}.intro-text{color:#666f7a;font-size:25rpx;line-height:1.8}

.video-pip-trigger { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; padding: 0; margin: 0; background: rgba(0,0,0,.6); border-radius: 50%; }
.video-pip-trigger::after { border: none; }
.pip-icon { width: 32rpx; height: 24rpx; border: 2rpx solid white; position: relative; border-radius: 3rpx; }
.pip-icon view { position: absolute; right: 3rpx; bottom: 3rpx; width: 13rpx; height: 9rpx; background: white; }
.video-container.player-fullscreen { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 9999; }
.player-fullscreen .video { width: 100%; height: 100%; }
.player-fullscreen .video-top-controls { top: max(20rpx, env(safe-area-inset-top)); }

/* Match the website's mobile toolbar: 40px controls, 16px icons, 12px labels. */
.video-top-controls { top: 8px; right: 8px; max-width: calc(100% - 16px); gap: 4px; padding: 4px 6px; border-radius: 12px; background: rgba(0,0,0,.7); }
.video-top-controls button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; height: 40px; min-width: 0; margin: 0; padding: 0 8px; border-radius: 20px; color: white; background: rgba(0,0,0,.6); font-size: 12px; line-height: 40px; font-weight: 600; }
.video-top-controls .video-quality-trigger { padding: 0 4px; background: transparent; }
.video-top-controls .video-pip-trigger,.video-top-controls .video-fullscreen-trigger { width: 40px; padding: 0; }
.video-top-controls .video-fullscreen-trigger { font-size: 22px; }
.video-top-controls .active { background: #2f80ed; }
.quality-arrow { font-size: 14px; }
.pip-icon { width: 16px; height: 12px; border-width: 1px; }
.pip-icon view { width: 7px; height: 5px; right: 1px; bottom: 1px; }
.video.mirrored { transform: scaleX(-1); }
.player-menu { top: 60px; right: 8px; width: 180px; max-height: calc(100% - 68px); overflow-y: auto; padding: 12px; }
.player-menu-option { min-width: 44px; min-height: 32px; font-size: 12px; }
.video-section-controls,.video-transport { position: absolute; left: 8px; right: 8px; display: flex; align-items: center; gap: 8px; z-index: 10; opacity: 0; pointer-events: none; }
.video-section-controls.visible,.video-transport.visible { opacity: 1; pointer-events: auto; }
.video-section-controls { bottom: 48px; justify-content: space-between; }
.lesson-controls { display: flex; gap: 4px; padding: 4px; border-radius: 24px; background: rgba(0,0,0,.6); }
.video-section-controls button,.video-transport button { margin: 0; padding: 0 8px; height: 32px; line-height: 32px; color: white; font-size: 12px; background: transparent; border-radius: 20px; }
.video-section-controls button[disabled] { opacity: .35; }
.video-transport { bottom: 4px; height: 40px; padding: 0 4px; border-radius: 8px; color: white; background: rgba(0,0,0,.7); }
.video-transport text { flex-shrink: 0; font-size: 10px; }
.video-transport slider { flex: 1; min-width: 0; margin: 0 4px; }
.video-transport button { flex-shrink: 0; padding: 0 4px; min-width: 32px; }
.outline-status { min-width: 44rpx; }
.outline-name { white-space: normal; line-height: 1.5; }
/* Override WeChat's default full-width button rule inside compact controls. */
.video-top-controls button,.video-section-controls button,.video-transport button,.playback-summary button { width: auto; flex: 0 0 auto; }
.video-top-controls .video-pip-trigger,.video-top-controls .video-fullscreen-trigger { width: 40px; }

.catalog-pagination { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 8px 0; padding: 6px 8px; border: 1px solid #e8ddcb; border-radius: 6px; background: #fffdf8; color: #a98746; font-size: 12px; font-weight: 600; }
.catalog-pagination button { flex: 0 0 28px; width: 28px; height: 28px; margin: 0; padding: 0; border: 1px solid #e8ddcb; border-radius: 6px; background: #fff; color: #a98746; font-size: 20px; line-height: 26px; }
.catalog-pagination button[disabled] { opacity: .4; }

.autoplay-countdown{position:absolute;left:12px;right:12px;top:45%;z-index:40;display:flex;align-items:center;gap:10px;padding:12px;color:#fff;background:rgba(0,0,0,.78);border-radius:12px;font-size:12px}.autoplay-countdown text{flex:1}.autoplay-countdown button{width:auto;margin:0;padding:0 12px;font-size:12px;line-height:40px;min-height:40px;background:#9f1d20;color:#fff}.note-time{display:block}

.course-purchase{padding:0 24rpx;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}.course-purchase .course-pricing{margin-top:0}.course-purchase button{margin:0;padding:0 24rpx;min-height:72rpx;line-height:72rpx;font-size:26rpx;color:#fff;background:#9f1d20;border-radius:16rpx}.course-purchase>text{color:#616773;font-size:24rpx}

/* Mobile lesson selection: keep the video controls independent from the catalog. */
.player-page{background:#f6f7f9}
.content{padding:24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom))}
