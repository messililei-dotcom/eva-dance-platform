.video-card .title{color:#202124;font-size:30rpx;font-weight:600;line-height:1.5;overflow-wrap:break-word}
.video-card .meta{margin-top:8rpx;color:#616773;font-size:24rpx;line-height:1.5}
.video-card .course-purchase{padding:0}
.playback-summary{flex-wrap:wrap;gap:12rpx;font-size:24rpx;color:#616773}
.playback-summary button{min-width:112rpx;min-height:88rpx;height:auto;display:flex;align-items:center;justify-content:center;line-height:1.4;font-size:26rpx;border-radius:16rpx}
.player-tabs{margin-top:24rpx;padding:0 16rpx;gap:16rpx;border:0;border-radius:24rpx;box-shadow:none}
.player-tab{width:auto;min-height:96rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;padding:20rpx 8rpx;color:#616773;font-size:28rpx;font-weight:500;line-height:1.4;border-radius:0;background:transparent}
.player-tab.active{color:#9f1d20;font-weight:700;border-bottom-color:#9f1d20}
.tab-count{padding:2rpx 10rpx;border-radius:8rpx;background:#f0f2f5;font-size:22rpx;font-variant-numeric:tabular-nums}
.player-tab.active .tab-count{background:#f9eaea}
.outline{margin-top:24rpx;padding:24rpx;border:0;border-radius:24rpx;box-shadow:none}
.catalog-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:20rpx}
.catalog-title{color:#202124;font-size:30rpx;font-weight:600;line-height:1.5}
.catalog-caption{margin-top:6rpx;color:#616773;font-size:24rpx;line-height:1.5}
.locate-lesson{width:auto;flex:0 0 auto;min-height:88rpx;padding:0 20rpx;display:flex;align-items:center;justify-content:center;color:#9f1d20;background:#f9eaea;border-radius:16rpx;font-size:24rpx}
.catalog-search{min-height:92rpx;gap:16rpx;margin:0;padding:0 20rpx;border:1rpx solid #d9dde3;border-radius:16rpx;background:#f6f7f9}
.catalog-search-icon{position:relative;flex:0 0 26rpx;height:26rpx;border:3rpx solid #616773;border-radius:50%;margin-right:4rpx}
.catalog-search-icon::after{position:absolute;right:-9rpx;bottom:-6rpx;width:12rpx;height:3rpx;background:#616773;content:"";transform:rotate(45deg)}
.catalog-search input{height:88rpx;padding:0;border:0;border-radius:0;background:transparent;color:#202124;font-size:26rpx}
.catalog-search button{width:auto;min-height:88rpx;height:auto;padding:0 8rpx;display:flex;align-items:center;justify-content:center;line-height:1.4;font-size:24rpx;color:#9f1d20}
.catalog-result{padding:16rpx 0 0;color:#616773;font-size:24rpx}
.catalog-pagination{gap:16rpx;margin:20rpx 0;padding:0;border:0;background:transparent;border-radius:0;color:#202124;font-size:24rpx;font-weight:500}
.catalog-pagination button{flex:0 0 128rpx;width:128rpx;min-height:88rpx;height:auto;display:flex;align-items:center;justify-content:center;padding:0 12rpx;border:1rpx solid #d9dde3;border-radius:16rpx;background:#fff;color:#9f1d20;font-size:24rpx;line-height:1.4}
