<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}"><template is="publicSharePreview" data="{{card:sharePreview}}" /></block>
<block wx:else>
<view class="page"><view wx:if="{{loading}}">正在加载评委资料…</view><view wx:elif="{{error}}">{{error}}<button bindtap="load">重新加载</button></view><block wx:elif="{{judge}}"><view class="profile"><image wx:if="{{judge.avatarUrl}}" src="{{judge.avatarUrl}}" mode="aspectFill"/><view wx:else class="initial">{{judge.initial}}</view><view class="name">{{judge.name}}</view><text>{{judge.title || '赛事评委'}}</text></view><view class="card"><view class="heading">评委介绍</view><view class="bio">{{judge.bio || '评委介绍暂未填写'}}</view><view wx:if="{{judge.organization}}">{{judge.organization}}</view></view><view class="card"><view class="heading">受邀赛事</view>{{competition.name}}</view><button bindtap="back">返回赛事</button></block><view wx:else>评委资料暂未公开</view></view>
</block>
