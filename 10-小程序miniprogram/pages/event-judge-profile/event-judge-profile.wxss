.page{min-height:100vh;padding:32rpx;background:#faf8f5;color:#2c1810;box-sizing:border-box}.profile{text-align:center;padding:40rpx 0}.profile image,.initial{width:180rpx;height:180rpx;border-radius:50%;margin:auto;border:3rpx solid #bd9d66}.initial{line-height:180rpx;font-size:64rpx;background:#f4ece1;color:#9e1726}.name{font-size:44rpx;font-weight:700;margin:24rpx 0 12rpx}.profile text{font-size:28rpx;color:#80633d}.card{padding:32rpx;background:#fff;border-radius:24rpx;margin-bottom:24rpx;font-size:28rpx;line-height:1.8}.heading{color:#9e1726;font-size:32rpx;font-weight:700;margin-bottom:20rpx}.bio{white-space:pre-wrap}button{background:#9e1726;color:white;min-height:96rpx}