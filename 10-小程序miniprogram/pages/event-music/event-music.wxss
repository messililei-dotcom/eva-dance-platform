.page{padding:24rpx;background:#f8f3ea;min-height:100vh}.card{padding:28rpx;background:#fff;border-radius:20rpx}.title{font-size:34rpx;font-weight:600;margin-bottom:24rpx}.field{display:block;margin:24rpx 0;font-size:28rpx}.field input{box-sizing:border-box;height:96rpx;padding:0 20rpx;margin-top:12rpx;border:1rpx solid #c9bba7;border-radius:12rpx;font-size:32rpx;color:#2c1810}.card button{min-height:88rpx;padding:20rpx;margin-top:20rpx;font-size:28rpx;background:#f8f3ea}.card .save{background:#9f1d20;color:#fff}.file-name{overflow-wrap:anywhere;margin-top:16rpx;font-size:26rpx}.note{font-size:24rpx;line-height:1.7;color:#695b4d;margin-top:16rpx}.error{color:#9f1d20;margin-top:20rpx;font-size:26rpx}

.field textarea{box-sizing:border-box;width:100%;height:180rpx;padding:20rpx;margin-top:12rpx;border:1rpx solid #c9bba7;border-radius:12rpx;background:#fff;font-size:28rpx;color:#2c1810}
