page {
  min-height: 100%;
  background: #f8f3ea;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.card {
  width: 100%;
  padding: 72rpx 40rpx 52rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(75, 45, 31, 0.1);
}

.success-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 36rpx;
  border-radius: 56rpx;
  background: #1aad19;
  color: #ffffff;
  font-size: 64rpx;
  line-height: 112rpx;
  font-weight: 700;
}

.title {
  color: #2c1810;
  font-size: 40rpx;
  font-weight: 700;
}

.description {
  margin: 24rpx auto 44rpx;
  color: #7b695c;
  font-size: 28rpx;
  line-height: 1.75;
}

.return-button {
  border: 0;
  border-radius: 999rpx;
  background: #1aad19;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.return-button::after {
  border: 0;
}
