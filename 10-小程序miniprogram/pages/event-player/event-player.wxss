.page{padding:24rpx;background:#f8f3ea;min-height:100vh}.hero{padding:38rpx;text-align:center;background:#17283d;border-radius:24rpx;color:#dfbf81}.avatar{width:130rpx;height:130rpx;margin:0 auto 20rpx;border-radius:50%;overflow:hidden;background:#dfbf81;color:#17283d;display:flex;align-items:center;justify-content:center;font-size:46rpx}.avatar image{width:100%;height:100%}.small{width:70rpx;height:70rpx;margin:0 16rpx 0 0;font-size:28rpx;flex-shrink:0}.title{font-size:32rpx;font-weight:800;margin-bottom:12rpx}.hero button{background:transparent;color:#dfbf81;font-size:24rpx;margin-top:18rpx}.card{margin-top:20rpx;padding:28rpx;line-height:1.8}.programme{margin-top:12rpx}.result{text-align:center;color:#a77c37}.score{font-size:56rpx;font-weight:800}.judge{display:flex;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #eee}.name{flex:1}.muted{font-size:22rpx;color:#918575}
