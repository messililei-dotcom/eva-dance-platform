.events-page{min-height:100vh;padding:0 20rpx 44rpx;background:#f6f7f9}.event-hero{padding:34rpx 26rpx 24rpx;color:#fff;background:#1a1a1a}.event-kicker{display:inline-flex;padding:8rpx 16rpx;border:1rpx solid rgba(200,169,110,.35);border-radius:999rpx;color:#c8a96e;background:rgba(200,169,110,.1);font-size:21rpx;font-weight:800}.event-title{margin-top:18rpx;font-size:42rpx;line-height:1.2;font-weight:900}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:24rpx;border:1rpx solid rgba(255,255,255,.1);background:rgba(255,255,255,.06)}.hero-stats view{padding:16rpx 8rpx;text-align:center;border-right:1rpx solid rgba(255,255,255,.1)}.hero-stats view:last-child{border:0}.hero-stats text,.hero-stats span{display:block}.hero-stats text{font-size:31rpx;font-weight:900}.hero-stats span{margin-top:5rpx;color:rgba(255,255,255,.62);font-size:19rpx}.list-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:24rpx 0 18rpx}.list-title{flex:0 0 auto;color:#202124;font-size:34rpx;font-weight:900}.event-search{display:flex;align-items:center;min-width:0;width:300rpx;height:62rpx;padding:0 14rpx;border:1rpx solid #e5d8c5;border-radius:999rpx;background:#fff}.event-search input{min-width:0;flex:1;font-size:22rpx}.event-search text{color:#616773;font-size:28rpx}.event-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.event-card{display:flex;min-width:0;overflow:hidden;flex-direction:column;border:1rpx solid rgba(200,169,110,.24);border-radius:16rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(44,24,16,.05)}.event-cover{position:relative;width:100%;aspect-ratio:4/3;background:#1a1a1a}.event-cover image,.event-cover-fallback{width:100%;height:100%}.event-cover-fallback{display:flex;align-items:center;justify-content:center;color:#c8a96e;background:linear-gradient(135deg,#8b1a1a,#7e6233);font-size:34rpx;font-weight:900}.event-status{position:absolute;top:12rpx;left:12rpx;padding:6rpx 12rpx;border-radius:999rpx;color:#fff;background:rgba(26,26,26,.75);font-size:18rpx;font-weight:800}.event-status.open{background:rgba(159,29,32,.92)}.event-body{display:flex;min-width:0;flex:1;flex-direction:column;padding:14rpx 14rpx 0}.event-info{margin-top:4rpx;overflow:hidden;color:#616773;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.event-name{display:-webkit-box;min-height:72rpx;margin-top:10rpx;overflow:hidden;color:#202124;font-size:25rpx;line-height:1.4;font-weight:900;-webkit-box-orient:vertical;-webkit-line-clamp:2}.event-data{display:grid;grid-template-columns:repeat(3,1fr);margin-top:14rpx;padding:11rpx 0;border-top:1rpx solid #e2e5e9;border-bottom:1rpx solid #e2e5e9}.event-data view{text-align:center}.event-data text,.event-data span{display:block}.event-data text{color:#9a793d;font-size:24rpx;font-weight:900}.event-data span{margin-top:3rpx;color:#616773;font-size:17rpx}.event-button{height:68rpx;margin:12rpx 14rpx 14rpx;border-radius:10rpx;color:#9f1d20;background:#fff;font-size:22rpx;font-weight:900;line-height:68rpx}.event-button.register{color:#fff;background:#9f1d20}.event-button::after{border:0}.empty-card{padding:76rpx 24rpx;border-radius:16rpx;color:#616773;background:#fff;text-align:center;font-size:24rpx}

.events-page{padding:32rpx}.event-hero{padding:0;background:transparent;color:#202124}.event-title{margin:0;font-size:42rpx;font-weight:700}.hero-stats{border:0;border-radius:24rpx;background:#fff}.hero-stats text{color:#9f1d20;font-weight:700}.hero-stats span{color:#616773;font-size:24rpx}.list-head{align-items:stretch;flex-direction:column;margin-top:32rpx}.event-search{width:100%;height:88rpx;border-color:#d9dde3;border-radius:24rpx}.event-search input{height:88rpx;font-size:28rpx}.event-list{grid-template-columns:1fr;gap:24rpx}.event-card{border:0;box-shadow:none;border-radius:24rpx}.event-cover{height:300rpx;aspect-ratio:auto;background:#f9eaea}.event-cover-fallback{background:#f9eaea;color:#9f1d20}.event-body{padding:24rpx 24rpx 0}.event-name{order:-1;min-height:0;margin:0 0 12rpx;font-size:32rpx;font-weight:600}.event-info,.event-data span{font-size:24rpx}.event-data text{color:#9f1d20;font-size:28rpx}.event-status{font-size:24rpx;top:20rpx;left:20rpx;padding:8rpx 18rpx}.event-button{height:88rpx;line-height:88rpx;font-size:28rpx;margin:20rpx 24rpx 24rpx}.empty-card{font-size:28rpx;line-height:1.6}
