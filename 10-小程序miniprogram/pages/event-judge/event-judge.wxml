<view class="page">
 <view wx:if="{{loading}}" class="card">正在加载评委工作台…</view>
 <view wx:elif="{{error}}" class="card"><text>{{error}}</text><button bindtap="load">重新加载</button></view>
 <block wx:else>
  <view class="card"><view class="title">{{competition.name}}</view><view class="muted">评委：{{judge.name}}</view><button wx:if="{{groupId}}" bindtap="goBack" disabled="{{submitting}}">{{playerId ? '返回选手列表' : '返回评分组别'}}</button></view>
  <input wx:if="{{!playerId}}" class="search" value="{{query}}" placeholder="搜索组别或选手" bindinput="onSearch"/><block wx:if="{{!groupId}}"><view class="card row" wx:for="{{visibleRows}}" wx:key="id" data-id="{{item.id}}" bindtap="openGroup"><text>{{item.ordinal}}. {{item.name}}</text><text class="muted">{{item.scored_count}} / {{item.player_count}} 已评分 ›</text></view><view wx:if="{{!groups.length}}" class="card">暂无授权组别</view></block>
  <block wx:elif="{{!playerId}}"><view class="card"><view class="title">{{group.name}}</view><view class="progress-text">评分进度 {{scoredCount}} / {{players.length}}</view><progress percent="{{players.length ? scoredCount / players.length * 100 : 0}}" activeColor="#9e1726" stroke-width="6"/><view class="filters"><button data-filter="all" bindtap="setFilter">全部</button><button data-filter="unscored" bindtap="setFilter">未评分</button><button data-filter="scored" bindtap="setFilter">已评分</button></view></view><view class="card row" wx:for="{{visibleRows}}" wx:key="id" data-id="{{item.id}}" bindtap="openPlayer"><view>{{item.name}}<view class="muted">{{item.player_no}} {{item.organization}}</view></view><text>{{item.my_score_status ? item.my_score : '未评分'}} ›</text></view><view wx:if="{{!players.length}}" class="card">暂无审核通过的选手</view></block>
  <view wx:else class="card"><view class="title">{{player.name}}</view><view class="muted">{{group.name}} · {{player.performance_title}}</view><view wx:if="{{currentScore.needsRescore}}" class="muted">历史评分为 {{currentScore.total}}，超出当前满分。请按当前10分制重新填写并提交评分。</view><view class="muted">输入分数，或左右拖动调节</view><view class="criterion" wx:for="{{criteria}}" wx:key="key"><view class="criterion-head"><text>{{item.name}}</text><text class="muted">满分 {{item.maxScore}} 分</text><input type="digit" cursor-spacing="120" value="{{item.value}}" data-index="{{index}}" bindinput="onScore" disabled="{{locked || submitting}}" placeholder="分数" /></view><view class="slider-row"><text>0</text><slider min="0" max="{{item.sliderMax}}" step="1" value="{{item.slider}}" data-index="{{index}}" bindchanging="onSlider" bindchange="onSlider" activeColor="#9e1726" block-size="24" disabled="{{locked || submitting}}"/><text>{{item.maxScore}}</text></view></view><view class="total"><view class="total-head"><text>总分（可修改）</text><input type="digit" value="{{total}}" bindfocus="beginTotal" bindinput="onTotal" disabled="{{locked || submitting}}"/><text>/ {{maxTotal}}</text></view><view class="muted">修改总分，各项按比例分配</view></view><view wx:if="{{locked}}" class="muted">该组别评分已锁定</view><button class="submit" bindtap="submit" loading="{{submitting}}" disabled="{{locked || submitting}}">{{currentScore.status ? '修改并提交评分' : '确认评分'}}</button></view>
<view wx:if="{{!playerId && pageCount > 1}}" class="pagination"><button data-offset="-1" disabled="{{pageNo <= 1}}" bindtap="changePage">上一页</button><text>{{pageNo}} / {{pageCount}}</text><button data-offset="1" disabled="{{pageNo >= pageCount}}" bindtap="changePage">下一页</button></view>
 </block>
</view>