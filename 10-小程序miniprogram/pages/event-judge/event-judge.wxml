<view class="page">
 <view wx:if="{{loading}}" class="card">正在加载评委工作台…</view>
 <view wx:elif="{{error}}" class="card"><text>{{error}}</text><button bindtap="load">重新加载</button></view>
 <block wx:else>
  <view class="card"><view class="title">{{competition.name}}</view><view class="muted">评委：{{judge.name}}</view><button wx:if="{{groupId}}" bindtap="goBack" disabled="{{submitting}}">{{playerId ? '返回选手' : '返回组别'}}</button></view>
  <input wx:if="{{!playerId}}" class="search" value="{{query}}" placeholder="搜索组别或选手" bindinput="onSearch"/><block wx:if="{{!groupId}}"><view class="card row" wx:for="{{visibleRows}}" wx:key="id" data-id="{{item.id}}" bindtap="openGroup"><text>{{item.ordinal}}. {{item.name}}</text><text class="muted">{{item.scored_count}} / {{item.player_count}} 已评分 ›</text></view><view wx:if="{{!groups.length}}" class="card">暂无授权组别</view></block>
  <block wx:elif="{{!playerId}}"><view class="card row" wx:for="{{visibleRows}}" wx:key="id" data-id="{{item.id}}" bindtap="openPlayer"><view>{{item.name}}<view class="muted">{{item.player_no}} {{item.organization}}</view></view><text>{{item.my_score_status ? item.my_score : '未评分'}} ›</text></view><view wx:if="{{!players.length}}" class="card">暂无审核通过的选手</view></block>
  <view wx:else class="card"><view class="title">{{player.name}}</view><view class="muted">{{group.name}} · {{player.performance_title}}</view><view class="criterion" wx:for="{{criteria}}" wx:key="key"><text>{{item.name}}（满分 {{item.maxScore}}）</text><input type="digit" value="{{item.value}}" data-index="{{index}}" bindinput="onScore" disabled="{{locked || submitting}}" placeholder="请输入分数" /></view><view class="total">总分 {{total}}</view><view wx:if="{{locked}}" class="muted">该组别评分已锁定</view><button class="submit" bindtap="submit" loading="{{submitting}}" disabled="{{locked || submitting}}">{{currentScore.status ? '修改并提交评分' : '提交评分'}}</button></view>
<view wx:if="{{!playerId && pageCount > 1}}" class="pagination"><button data-offset="-1" disabled="{{pageNo <= 1}}" bindtap="changePage">上一页</button><text>{{pageNo}} / {{pageCount}}</text><button data-offset="1" disabled="{{pageNo >= pageCount}}" bindtap="changePage">下一页</button></view>
 </block>
</view>