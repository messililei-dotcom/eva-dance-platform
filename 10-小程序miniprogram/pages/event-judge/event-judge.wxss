.page{padding:24rpx;background:#f8f5f0;min-height:100vh}.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx}.title{font-size:34rpx;font-weight:600;margin-bottom:16rpx}.muted{font-size:24rpx;color:#888;margin-top:10rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.criterion{margin-top:28rpx}.criterion input{border:1rpx solid #ddd;border-radius:12rpx;padding:20rpx;margin-top:12rpx}.total{font-size:40rpx;color:#9f1d20;text-align:center;margin:32rpx 0}.submit{background:#9f1d20;color:#fff}
.search{height:76rpx;padding:0 20rpx;background:#fff;border-radius:12rpx;font-size:24rpx}.pagination{display:flex;align-items:center;gap:16rpx;font-size:24rpx}.pagination button{font-size:24rpx}
