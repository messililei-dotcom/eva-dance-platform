.page{padding:24rpx;background:#f8f5f0;min-height:100vh}.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx}.title{font-size:34rpx;font-weight:600;margin-bottom:16rpx}.muted{font-size:24rpx;color:#888;margin-top:10rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.criterion{margin-top:28rpx}.criterion input{box-sizing:border-box;width:100%;height:100rpx;min-height:100rpx;border:1rpx solid #c9bba7;border-radius:12rpx;padding:0 20rpx;margin-top:12rpx;background:#fff;color:#2c1810;font-size:36rpx;font-weight:600;line-height:normal;text-align:left}.total{font-size:40rpx;color:#9f1d20;text-align:center;margin:32rpx 0}.submit{background:#9f1d20;color:#fff}
.search{height:76rpx;padding:0 20rpx;background:#fff;border-radius:12rpx;font-size:24rpx}.pagination{display:flex;align-items:center;gap:16rpx;font-size:24rpx}.pagination button{font-size:24rpx}

.page{background:#faf8f5}.title{color:#2c1810}.muted{color:#6b5c52}.criterion{padding:20rpx 0;border-bottom:1rpx solid #e8ddd0}.criterion-head,.slider-row,.total-head{display:flex;align-items:center;gap:16rpx}.criterion-head>text:first-child{flex:1;font-weight:600}.criterion-head .muted{font-size:22rpx}.criterion-head input{width:150rpx;height:88rpx;min-height:88rpx;margin:0;text-align:center;font-size:38rpx;color:#9e1726}.slider-row slider{flex:1;min-width:0;margin:8rpx 0}.slider-row{font-size:24rpx;color:#6b5c52}.total{padding:28rpx 16rpx;background:#f4ece1;border-radius:24rpx}.total-head{justify-content:center;font-size:28rpx}.total input{width:170rpx;height:88rpx;background:#fff;border:1rpx solid #bda27c;border-radius:16rpx;font-size:40rpx}.submit{min-height:96rpx;background:#9e1726;border-radius:18rpx}.filters{display:flex;gap:12rpx;margin-top:20rpx}.filters button{flex:1;font-size:26rpx;color:#9e1726;background:#f8f2eb}.progress-text{font-size:28rpx;margin-bottom:16rpx}
