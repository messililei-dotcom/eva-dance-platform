page{background:#f8f3ea;color:#2c1810}.messages-page{padding:24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom))}.toolbar{display:flex;align-items:center;gap:16rpx;padding:24rpx;background:#fff;border-radius:24rpx 24rpx 0 0}.heading{font-size:36rpx;font-weight:700;flex:1}.badge{display:inline-block;background:#9f1d20;color:#fff;border-radius:30rpx;padding:2rpx 12rpx;font-size:22rpx}.text-button{width:auto;margin:0;padding:0 8rpx;background:none;color:#8a6a32;font-size:24rpx;line-height:64rpx}.text-button::after,.filter::after,.close::after{border:0}.filters{display:flex;gap:10rpx;padding:16rpx;background:#fff;margin-bottom:20rpx;border-radius:0 0 24rpx 24rpx}.filter{flex:1;margin:0;padding:0;background:#f8f3ea;color:#7b6b5b;font-size:24rpx;line-height:64rpx;border-radius:40rpx}.filter.active,.related{background:#9f1d20;color:#fff}.message{background:#fff;border:1rpx solid #eee2d0;border-radius:20rpx;padding:26rpx;margin-bottom:16rpx}.message.unread{background:#fff9ee}.message-heading,.dialog-heading{display:flex;align-items:center;gap:12rpx}.title{flex:1;font-size:30rpx;font-weight:600;word-break:break-all}.dot{width:12rpx;height:12rpx;border-radius:50%;background:#e02020;flex-shrink:0}.urgent{font-size:22rpx;color:#9f1d20}.summary{font-size:26rpx;color:#7b6b5b;line-height:1.7;margin-top:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.meta{font-size:22rpx;color:#948472;margin-top:14rpx}.empty{text-align:center;padding:80rpx 0;color:#8a7a68}.error{padding:20rpx;background:#fff0ed;color:#9f1d20}.load-more{background:#fff;color:#9f1d20;font-size:28rpx}.overlay{position:fixed;inset:0;background:rgba(33,23,17,.5);z-index:1000;display:flex;align-items:center;justify-content:center;padding:30rpx}.dialog{width:100%;box-sizing:border-box;border-radius:24rpx;background:#fff;padding:28rpx}.close{flex-shrink:0;width:auto;margin:0;padding:0 16rpx;font-size:24rpx;line-height:64rpx;background:#f8f3ea;color:#8a6a32}.body-scroll{max-height:55vh;margin:28rpx 0}.body{white-space:pre-wrap;word-break:break-all;font-size:28rpx;line-height:1.9;color:#5f5145}.related{font-size:28rpx;border-radius:16rpx}
