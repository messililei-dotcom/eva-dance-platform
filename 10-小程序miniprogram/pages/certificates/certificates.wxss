.page {
  min-height: 100vh;
  padding: 20rpx;
  background: #f6f7f9;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e4e7ec;
  border-top-color: #ff5b45;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #8c8172;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #202124;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-hint {
  margin-top: 12rpx;
  color: #8c8172;
  font-size: 26rpx;
}

.cert-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cert-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.cert-icon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fef3e6, #fae4ce);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.cert-main {
  flex: 1;
  min-width: 0;
}

.cert-name {
  color: #202124;
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cert-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8c8172;
  font-size: 23rpx;
}

.cert-sep {
  color: #d9d0c7;
}

.cert-no {
  word-break: break-all;
}

.cert-action {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  color: #ff5b45;
  background: #fff2ef;
  font-size: 24rpx;
  font-weight: 800;
}

.cert-action.revoked {
  color: #8c8172;
  background: #f0f0f0;
}
