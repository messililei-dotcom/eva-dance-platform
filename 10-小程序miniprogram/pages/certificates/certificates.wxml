<view class="page">
  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state card" wx:elif="{{!certificates.length}}">
    <text class="empty-icon">📜</text>
    <text class="empty-text">暂无记录</text>
    <text class="empty-hint">播放内容后会显示对应记录</text>
  </view>

  <!-- 记录列表 -->
  <view class="cert-list" wx:else>
    <view
      class="cert-item card"
      wx:for="{{certificates}}"
      wx:key="certificateNo"
      bindtap="viewCertificate"
      data-url="{{item.openUrl}}"
    >
      <view class="cert-icon">
        <text>🏆</text>
      </view>
      <view class="cert-main">
        <view class="cert-name">{{item.courseName}}</view>
        <view class="cert-meta">
          <text class="cert-date">{{item.issueDate}}</text>
          <text class="cert-sep">·</text>
          <text class="cert-no">{{item.certificateNo}}</text>
        </view>
      </view>
      <view class="cert-action {{item.actionText === '已撤销' ? 'revoked' : ''}}">{{item.actionText}}</view>
    </view>
  </view>
</view>
