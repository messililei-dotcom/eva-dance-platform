.learning-card {
  display: grid;
  grid-template-columns: 164rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: center;
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.thumb,
.recommend-thumb {
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
  color: #ffffff;
  background: linear-gradient(145deg, #2f3642, #b46d4b);
  font-weight: 900;
}

.thumb {
  width: 164rpx;
  height: 164rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.thumb image,
.recommend-thumb image {
  width: 100%;
  height: 100%;
}

.thumb-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  max-width: 118rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.56);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-info,
.recommend-main {
  min-width: 0;
}

.course-top {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: start;
}

.course-title {
  color: #252c35;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.percent {
  color: #ff5b45;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.course-meta {
  margin-top: 10rpx;
  color: #8c8172;
  font-size: 24rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-track {
  height: 12rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #efe6d9;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ff5b45;
}

.course-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: #9a8f80;
  font-size: 22rpx;
  line-height: 1.3;
}

.course-action {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #2f6d4d;
  background: #e9f6ef;
  font-size: 22rpx;
  font-weight: 800;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.recommend-card {
  overflow: hidden;
  padding: 0 0 20rpx;
}

.recommend-thumb {
  width: 100%;
  height: 176rpx;
  border-radius: 0;
  font-size: 28rpx;
}

.recommend-main {
  padding: 18rpx 18rpx 0;
}

.recommend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.recommend-badge {
  max-width: 120rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: #a44d39;
  background: rgba(255, 91, 69, 0.1);
  font-size: 20rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-action {
  flex: 0 0 auto;
  color: #ff5b45;
  font-size: 20rpx;
  font-weight: 900;
}

.recommend-title {
  min-height: 72rpx;
  color: #252c35;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 900;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-meta {
  margin-top: 10rpx;
  color: #8c8172;
  font-size: 22rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
