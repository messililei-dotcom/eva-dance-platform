<view class="page">
  <view class="section">
    <view wx:if="{{authorizedTraining.length}}">
      <view class="learning-card card" wx:for="{{authorizedTraining}}" wx:key="id" bindtap="openAuthorizedCourse" data-id="{{item.id}}">
        <view class="thumb">
          <image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" binderror="onImageError" data-path="authorizedTraining[{{index}}].cover_image"></image>
          <text wx:else>{{item.badge}}</text>
          <view class="thumb-badge">{{item.badge}}</view>
        </view>
        <view class="course-info">
          <view class="course-top">
            <view class="course-title">{{item.name}}</view>
            <view class="percent">{{item.percent}}%</view>
          </view>
          <view class="course-meta">{{item.subtitle || item.teacher || '伊娃东方舞'}} · {{item.lessonCount || item.courseCount || 0}} 项内容</view>
          <view class="progress-track"><view class="progress-fill" style="width: {{item.percent}}%;"></view></view>
          <view class="course-bottom">
            <text>{{item.completedLessonCount || 0}}/{{item.lessonCount || item.courseCount || 0}} 已完成</text>
            <text class="course-action">{{item.actionText}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty card">当前账号暂无可播放内容。</view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>推荐内容</text>
    </view>
    <view wx:if="{{recommendedTraining.length}}" class="recommend-grid">
      <view class="recommend-card card" wx:for="{{recommendedTraining}}" wx:key="id" bindtap="goRecommend" data-id="{{item.id}}" data-source="{{item.sourceType}}">
        <view class="recommend-thumb">
          <image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" binderror="onImageError" data-path="recommendedTraining[{{index}}].cover_image"></image>
          <text wx:else>{{item.badge}}</text>
        </view>
        <view class="recommend-main">
          <view class="recommend-head">
            <text class="recommend-badge">{{item.badge}}</text>
            <text class="recommend-action">{{item.actionText}}</text>
          </view>
          <view class="recommend-title">{{item.title}}</view>
          <view class="recommend-meta">{{item.meta}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty card">暂无可推荐内容。</view>
  </view>
</view>
