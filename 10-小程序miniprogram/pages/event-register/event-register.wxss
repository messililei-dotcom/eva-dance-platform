.register-page{min-height:100vh;padding:22rpx 20rpx 48rpx;background:#f8f3ea}.register-head{padding:30rpx;border-radius:24rpx 24rpx 0 0;color:#fff;background:#1a1a1a}.register-kicker{display:inline-flex;padding:7rpx 14rpx;border:1rpx solid rgba(200,169,110,.35);border-radius:999rpx;color:#c8a96e;background:rgba(200,169,110,.1);font-size:20rpx;font-weight:800}.register-title{margin-top:18rpx;font-size:35rpx;line-height:1.35;font-weight:900}.register-note{margin-top:13rpx;color:rgba(255,255,255,.7);font-size:22rpx;line-height:1.5}.form-card{padding:8rpx 24rpx 22rpx;border-radius:0 0 24rpx 24rpx;border-color:#eadfce;box-shadow:none}.form-title{padding:22rpx 0 14rpx;border-bottom:1rpx solid #efe4d4}.form-title view{color:#2c1810;font-size:31rpx;font-weight:900}.form-title text{display:block;margin-top:5rpx;color:#8a7a68;font-size:20rpx}.field{display:grid;grid-template-columns:180rpx minmax(0,1fr);align-items:center;min-height:94rpx;border-bottom:1rpx solid #efe4d4}.field>text,.music-label{font-size:24rpx;font-weight:800}.field input,.picker-value{width:100%;font-size:24rpx;text-align:right}.field input[disabled]{color:#8a7a68;background:#f8f3ea}.picker-value.placeholder{color:#a49685}.music-field{padding:22rpx 0;border-bottom:1rpx solid #efe4d4}.music-button{height:72rpx;margin-top:14rpx;border-radius:12rpx;color:#fff;background:#9f1d20;font-size:24rpx;font-weight:800;line-height:72rpx}.music-button::after{border:0}.music-name{margin-top:10rpx;overflow:hidden;color:#8a7a68;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.textarea-field{align-items:start;padding:22rpx 0}.textarea-field textarea{width:100%;height:150rpx;padding:16rpx;border:1rpx solid #eadfce;border-radius:14rpx;background:#fff;font-size:23rpx;text-align:left}.submit-btn{height:86rpx;margin-top:24rpx;border-radius:14rpx;color:#fff;background:#9f1d20;font-size:28rpx;line-height:86rpx;font-weight:900}.submit-btn::after{border:0}.submit-note{margin-top:14rpx;color:#8a7a68;font-size:20rpx;line-height:1.5;text-align:center}

.group-search{height:72rpx;padding:0 20rpx;margin-top:20rpx;border:1rpx solid #eadfce;border-radius:12rpx;font-size:24rpx}.draft-note,.fee-note{padding:18rpx 0;color:#9f1d20;font-size:24rpx}.music-preview{margin-top:12rpx;font-size:24rpx;background:#f8f3ea;color:#9f1d20}
