  "contentHtml": "<style>\n.swod-schedule{--ink:#2c1810;--wine:#8c293e;--line:#dfd1bd;color:#55483c;font-variant-numeric:tabular-nums;line-height:1.8}.swod-schedule *{box-sizing:border-box}.swod-schedule p{margin:0!important}.swod-schedule h2{margin:0 0 14px!important;font-family:inherit!important;font-size:22px!important;line-height:1.5;font-weight:700}.swod-schedule h3{margin:0!important;font-family:inherit!important;font-size:17px!important;line-height:1.6;font-weight:700}.swod-schedule section{margin:30px 0;scroll-margin-top:90px}.swod-schedule a:focus-visible,.swod-schedule summary:focus-visible{outline:3px solid var(--wine);outline-offset:4px}.swod-schedule .upcoming{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.swod-schedule .quick{display:block;border:1px solid var(--line);border-top:3px solid var(--wine);border-radius:12px;padding:18px 20px;background:#fffdf9;color:var(--ink);text-decoration:none}.swod-schedule .quick .label{font-weight:700;font-size:16px}.swod-schedule .quick .date{font-size:26px;line-height:1.5;font-weight:700;color:var(--wine);margin:4px 0}.swod-schedule .small{font-size:13px;color:#746454;line-height:1.8}.swod-schedule .jump{font-size:13px;font-weight:700;color:var(--wine);margin-top:8px}.swod-schedule .tools{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line)}.swod-schedule .tools a{font-size:14px;color:var(--wine);text-decoration:none;font-weight:600;padding:4px 0}.swod-schedule .section-date{font-size:14px;color:var(--wine);margin:-8px 0 14px!important}.swod-schedule .times{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fffdf9}.swod-schedule .slot{display:grid;grid-template-columns:125px minmax(0,1fr);gap:12px;padding:14px 18px;border-bottom:1px solid var(--line);font-size:15px}.swod-schedule .slot:last-child{border-bottom:0}.swod-schedule time{color:var(--wine);font-weight:700;white-space:nowrap}.swod-schedule .slot strong{color:var(--ink);font-weight:600}.swod-schedule details{border:1px solid var(--line);border-radius:12px;margin:14px 0;background:#fffdf9}.swod-schedule summary{cursor:pointer;padding:15px 18px;font-size:15px;font-weight:700;color:var(--ink);line-height:1.7}.swod-schedule .day{display:grid;grid-template-columns:74px minmax(0,1fr);gap:12px;padding:16px 18px;border-top:1px solid var(--line);font-size:14px}.swod-schedule .day strong{color:var(--wine)}.swod-schedule ol{padding-left:20px;margin:5px 0 10px;list-style:decimal}.swod-schedule li{margin:0!important}.swod-schedule .phase-title{background:#eee4d5;padding:12px 18px;color:var(--ink);font-size:16px;font-weight:700}.swod-schedule .two-phases{display:grid;grid-template-columns:1fr 1fr;gap:14px}.swod-schedule .two-phases .slot{grid-template-columns:1fr;gap:3px}.swod-schedule .annual-row{display:grid;grid-template-columns:145px minmax(0,1fr);gap:12px;padding:14px 18px;border-top:1px solid var(--line);font-size:14px}.swod-schedule .annual-row time{white-space:normal;font-size:13px}.swod-schedule .downloads{display:flex;flex-wrap:wrap;gap:8px}.swod-schedule .downloads a{display:block;padding:10px 14px;border:1px solid var(--line);border-radius:8px;background:#fffdf9;font-size:14px;color:var(--wine);text-decoration:none}.swod-schedule .consult{display:inline-block;border-radius:24px;background:var(--wine);color:#fff!important;font-size:14px;font-weight:600;text-decoration:none;padding:10px 24px;margin:4px 0 18px}.swod-schedule .muted-note{font-size:12px;color:#746454;padding:0 18px 16px;line-height:1.8}\n@media(max-width:600px){.swod-schedule .upcoming,.swod-schedule .two-phases{grid-template-columns:1fr}.swod-schedule .quick{padding:14px 18px}.swod-schedule .quick .date{font-size:24px}.swod-schedule .slot{grid-template-columns:112px minmax(0,1fr);padding:12px 14px;font-size:14px;gap:8px}.swod-schedule .two-phases .slot{grid-template-columns:112px minmax(0,1fr)}.swod-schedule .annual-row{grid-template-columns:106px minmax(0,1fr);padding:14px;gap:10px}.swod-schedule .day{grid-template-columns:64px minmax(0,1fr);padding:14px;gap:8px}}\n@media(max-width:360px){.swod-schedule .slot,.swod-schedule .two-phases .slot{grid-template-columns:1fr;gap:3px}}\n</style><div class=\"swod-schedule\"><div class=\"upcoming\" aria-label=\"近期两期课程\"><a class=\"quick\" href=\"#schedule-teacher\"><div class=\"label\">认证师资课 · 1—2级</div><div class=\"date\">11月25日—12月4日</div><div class=\"small\">SWOD《东方舞技巧大全》<br>10天 · 上午选修，下午及晚间授课</div><div class=\"jump\">查看课程安排 ↓</div></a><a class=\"quick\" href=\"#schedule-dance\"><div class=\"label\">第三届舞感双修班</div><div class=\"date\">12月18日—27日</div><div class=\"small\">东方舞 ＆ 民俗舞<br>10天 · 每天3个授课时段</div><div class=\"jump\">查看课程安排 ↓</div></a></div><div class=\"tools\"><a href=\"#schedule-year\">查看全年安排</a><a href=\"#schedule-images\">保存完整课表</a><a href=\"/contact\">咨询课程</a></div><section id=\"schedule-teacher\"><h2>认证师资课</h2><p class=\"section-date\">11月25日—12月4日 · 1—2级</p><div class=\"times\"><div class=\"slot\"><time>10:30—12:30</time><div><strong>上午选修</strong><div class=\"small\">11/25—29 核心训练 · Monica海艳<br>11/30—12/4 乐理与节奏 · Elina七七</div></div></div><div class=\"slot\"><time>14:30—17:00</time><div><strong>技巧与训练组合</strong><div class=\"small\">授课：伊娃</div></div></div><div class=\"slot\"><time>17:30—19:00</time><div><strong>腰腹肌控技巧</strong><div class=\"small\">延伸力与控制 · 伊娃</div></div></div><div class=\"slot\"><time>19:30—21:30</time><div><strong>教学法与理论 / 舞台与职业指导</strong><div class=\"small\">授课：伊娃</div></div></div></div><details id=\"schedule-days\"><summary>查看每天学什么（10天）</summary><div class=\"day\"><strong>11月25日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>形体力训练和7个脚位的稳定性力</li><li>手臂力量训练和手位定点控制</li><li>教学训练组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：理论 / 舞蹈发展</p></div></div><div class=\"day\"><strong>11月26日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>腿部力量和脚位训练组合</li><li>腿部技巧（起范儿 / 起势）</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：训练原理 / 核心</p></div></div><div class=\"day\"><strong>11月27日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>腿部力量和脚位训练组合</li><li>步伐＋技巧训练组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：舞蹈美学启蒙</p></div></div><div class=\"day\"><strong>11月28日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>腿部力量和脚位训练组合</li><li>步伐＋技巧训练组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：舞蹈空间与运用</p></div></div><div class=\"day\"><strong>11月29日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>腿部力量和脚位训练组合</li><li>步伐＋技巧训练组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：核心与核心训练</p></div></div><div class=\"day\"><strong>11月30日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>胸腰训练 / 手臂流动</li><li>技巧训练组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：核心与核心训练</p></div></div><div class=\"day\"><strong>12月1日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>胸腰训练 / 手臂流动</li><li>手臂流动组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：风格解析－1</p></div></div><div class=\"day\"><strong>12月2日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>胸腰训练 / 手臂流动</li><li>胸腰舞感提升训练组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>技巧教学法：风格解析－1</p></div></div><div class=\"day\"><strong>12月3日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>西米技巧</li><li>西米组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>舞蹈妆容 / 演出妆</p></div></div><div class=\"day\"><strong>12月4日</strong><div><p class=\"small\">14:30—17:00 · 伊娃</p><ol><li>腰腹肌控技巧（力量训练）</li><li>阿拉贝斯形体训练以及步伐</li><li>舞姿训练组合</li></ol><p class=\"small\">19:30—21:30 · 伊娃</p><p>个人路线发展指导</p></div></div></details></section><section id=\"schedule-dance\"><h2>舞感双修班</h2><p class=\"section-date\">12月18日—27日 · 第三届</p><div class=\"two-phases\"><div class=\"times\"><div class=