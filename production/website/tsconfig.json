{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "downlevelIteration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "/www/wwwroot/dongfangwuquan/website/.next.login-device-fix-20260907/types/**/*.ts",
    "/www/wwwroot/dongfangwuquan/website/.next.login-device-fix-20260907/dev/types/**/*.ts",
    ".next-avatar-20260908/types/**/*.ts",
    ".next-avatar-20260908/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backups/**/*",
    "deploy-backups/**/*",
    "local-backups/**/*",
    "releases/**/*"
  ]
}
