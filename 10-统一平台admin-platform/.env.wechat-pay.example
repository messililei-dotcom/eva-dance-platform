# Server only. Use the AppID bound to this merchant for the payment channel.
# This configuration does not enable online payments.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PUBLIC_KEY_ID=

# Absolute paths outside the repository and public/; grant access only to the service user.
# Each secret accepts either KEY_FILE or KEY, never both. Prefer files.
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_API_V3_KEY_FILE=
WECHAT_PAY_PUBLIC_KEY_FILE=

# Mini-program virtual payment is separate from ordinary WeChat Pay.
# Use the mini-program's OfferID and current-environment AppKey on the server.
WECHAT_VIRTUAL_LIVE_ENABLED=false
WECHAT_VIRTUAL_OFFER_ID=
WECHAT_VIRTUAL_LIVE_APP_KEY=
# Map each platform series ID to its published live item and exact price in cents.
# WECHAT_VIRTUAL_LIVE_PRODUCTS='{"21":{"productId":"published-live-product-id","priceFen":29900}}'
WECHAT_VIRTUAL_LIVE_PRODUCTS='{}'
