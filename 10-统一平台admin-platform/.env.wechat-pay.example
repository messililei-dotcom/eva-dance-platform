# Server only. Use the AppID bound to this merchant for the payment channel.
# This configuration does not enable online payments.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PUBLIC_KEY_ID=

# Absolute paths outside the repository and public/; grant access only to the service user.
# Each secret accepts either KEY_FILE or KEY, never both. Prefer files.
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_API_V3_KEY_FILE=
WECHAT_PAY_PUBLIC_KEY_FILE=
