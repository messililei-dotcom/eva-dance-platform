[Unit]
Description=Compress Eva website and admin images without changing URLs
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/eva-image-compression.lock /usr/bin/node /usr/local/lib/eva-image-compression/compress-server-images.cjs
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=768M
TimeoutStartSec=45min
UMask=0077
StandardOutput=journal
StandardError=journal
