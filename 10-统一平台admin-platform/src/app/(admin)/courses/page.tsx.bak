'use client';
import { useState } from 'react';
import { Table, Card, Tag, Space, Button, Input, Select, Row, Col, Statistic, Modal, Form, InputNumber, message, Tabs, Progress, Empty } from 'antd';
import { PlusOutlined, SearchOutlined, ReloadOutlined, EditOutlined, DeleteOutlined, BookOutlined, VideoCameraOutlined, TeamOutlined } from '@ant-design/icons';

// Mock courses data
const onlineCourses = Array.from({ length: 15 }, (_, i) => ({
  key: String(100 + i),
  name: ['埃及东方舞入门系统课', '舞码技巧进阶课', '东方舞文化理论', '纱巾舞专攻课', '藤杖舞基础训练',
    '埃及节奏解析', '即兴舞码创作', '舞台表现力训练', '东方舞音乐鉴赏', '形体与姿态课',
    '旋转技巧专攻', '手臂与线条训练', '舞码编排入门', '表演舞码《沙漠玫瑰》', '东方舞师资预备课'][i],
  type: 'online',
  level: ['入门', '初级', '中级', '高级', '全级别'][i % 5],
  chapters: [6, 8, 10, 12, 4, 6, 8, 10, 6, 8, 4, 6, 8, 10, 12][i],
  lessons: [24, 32, 40, 48, 16, 24, 32, 40, 24, 32, 16, 24, 32, 40, 48][i],
  students: [45, 38, 52, 28, 33, 41, 19, 27, 36, 22, 15, 18, 24, 31, 12][i],
  status: 'active',
  createdAt: `2026-0${3 + Math.floor(i / 6)}-0${(i % 9) + 1}${i > 8 ? '' : ''}`,
}));

const offlineCourses = Array.from({ length: 13 }, (_, i) => ({
  key: String(200 + i),
  name: ['五一·埃及东方舞系统集训', '暑期东方舞大师班', '国庆·东方舞特训营', '周末舞码工作坊',
    '东方舞师资班·初级', '东方舞师资班·中级', '东方舞师资班·高级',
    '秋季常规班·入门', '秋季常规班·初级', '秋季常规班·中级',
    '东方舞沙龙·表演专题', '舞码编排训练营', '一对一私教课'][i],
  type: 'offline',
  level: ['全级别', '中级', '全级别', '全级别', '初级', '中级', '高级', '入门', '初级', '中级', '全级别', '全级别', '定制'][i % 13],
  sessions: [5, 7, 5, 2, 12, 12, 12, 10, 10, 10, 1, 4, 0][i],
  students: [24, 18, 30, 15, 12, 8, 6, 22, 18, 12, 35, 10, 0][i],
  capacity: [30, 25, 35, 20, 15, 12, 10, 25, 20, 15, 50, 15, 1][i],
  status: 'active',
  startDate: `2026-0${5 + Math.floor(i / 4)}-${String(1 + (i * 3) % 28).padStart(2, '0')}`,
}));

export default function CoursesPage() {
  const [tab, setTab] = useState('online');
  const [searchText, setSearchText] = useState('');
  const [modalVisible, setModalVisible] = useState(false);

  const onlineFiltered = onlineCourses.filter(c => !searchText || c.name.includes(searchText));
  const offlineFiltered = offlineCourses.filter(c => !searchText || c.name.includes(searchText));

  const baseColumns = [
    { title: '课程名称', dataIndex: 'name', key: 'name', width: 250, render: (v: string) => <a>{v}</a> },
    { title: '级别', dataIndex: 'level', key: 'level', width: 80, render: (v: string) => <Tag>{v}</Tag> },
    { title: '章节数', dataIndex: 'chapters', key: 'chapters', width: 80, align: 'right' as const },
    { title: '课时', dataIndex: 'lessons', key: 'lessons', width: 80, align: 'right' as const },
    { title: '学员数', dataIndex: 'students', key: 'students', width: 100, align: 'right' as const },
    { title: '状态', dataIndex: 'status', key: 'status', width: 80, render: () => <Tag color="green">已上架</Tag> },
    { title: '创建时间', dataIndex: 'createdAt', key: 'createdAt', width: 120 },
    { title: '操作', key: 'action', width: 120,
      render: () => <Space><Button type="link" size="small" icon={<EditOutlined />}>编辑</Button><Button type="link" size="small" danger icon={<DeleteOutlined />}>下架</Button></Space> },
  ];

  const offlineColumns = [
    { title: '课程名称', dataIndex: 'name', key: 'name', width: 250, render: (v: string) => <a>{v}</a> },
    { title: '级别', dataIndex: 'level', key: 'level', width: 80, render: (v: string) => <Tag>{v}</Tag> },
    { title: '课次', dataIndex: 'sessions', key: 'sessions', width: 70, align: 'right' as const },
    { title: '已报', dataIndex: 'students', key: 'students', width: 80, align: 'right' as const },
    { title: '名额', dataIndex: 'capacity', key: 'capacity', width: 80, align: 'right' as const,
      render: (_: any, r: any) => <Progress percent={Math.round(r.students / r.capacity * 100)} size="small" style={{ width: 80 }} /> },
    { title: '开始日期', dataIndex: 'startDate', key: 'startDate', width: 100 },
    { title: '状态', dataIndex: 'status', key: 'status', width: 80, render: () => <Tag color="green">进行中</Tag> },
    { title: '操作', key: 'action', width: 120,
      render: () => <Space><Button type="link" size="small" icon={<EditOutlined />}>编辑</Button><Button type="link" size="small" danger>取消</Button></Space> },
  ];

  const totalStudents = onlineCourses.reduce((s, c) => s + c.students, 0) + offlineCourses.reduce((s, c) => s + c.students, 0);

  return (
    <div>
      <h2 style={{ marginBottom: 16, color: '#1f2937' }}>课程管理</h2>

      <Row gutter={16} style={{ marginBottom: 16 }}>
        <Col span={6}><Card size="small"><Statistic title="线上课程" value={onlineCourses.length} prefix={<VideoCameraOutlined />} valueStyle={{ color: '#3b82f6' }} /></Card></Col>
        <Col span={6}><Card size="small"><Statistic title="线下课程" value={offlineCourses.length} prefix={<TeamOutlined />} valueStyle={{ color: '#f59e0b' }} /></Card></Col>
        <Col span={6}><Card size="small"><Statistic title="总课程" value={onlineCourses.length + offlineCourses.length} prefix={<BookOutlined />} valueStyle={{ color: '#a855f7' }} /></Card></Col>
        <Col span={6}><Card size="small"><Statistic title="累计学员" value={totalStudents} suffix="人次" valueStyle={{ color: '#10b981' }} /></Card></Col>
      </Row>

      <Card
        size="small"
        title={<Tabs activeKey={tab} onChange={setTab} items={[
          { key: 'online', label: `线上课程 (${onlineCourses.length})` },
          { key: 'offline', label: `线下课程 (${offlineCourses.length})` },
        ]} />}
        extra={<Space><Input placeholder="搜索课程..." prefix={<SearchOutlined />} style={{ width: 200 }} value={searchText} onChange={e => setSearchText(e.target.value)} allowClear /><Button type="primary" icon={<PlusOutlined />} onClick={() => setModalVisible(true)}>新增课程</Button></Space>}
      >
        <Table columns={tab === 'online' ? baseColumns : offlineColumns}
          dataSource={tab === 'online' ? onlineFiltered : offlineFiltered}
          size="middle" pagination={{ pageSize: 20, showTotal: t => `共 ${t} 门课程` }} />
      </Card>

      <Modal title="新增课程" open={modalVisible} onCancel={() => setModalVisible(false)} footer={null} width={600}>
        <Form layout="vertical">
          <Form.Item label="课程名称" required><Input placeholder="请输入课程名称" /></Form.Item>
          <Row gutter={16}>
            <Col span={12}><Form.Item label="课程类型" required><Select options={[{ label: '线上课程', value: 'online' }, { label: '线下课程', value: 'offline' }]} /></Form.Item></Col>
            <Col span={12}><Form.Item label="难度级别"><Select options={[{ label: '入门', value: 'beginner' }, { label: '初级', value: 'elementary' }, { label: '中级', value: 'intermediate' }, { label: '高级', value: 'advanced' }, { label: '全级别', value: 'all' }]} /></Form.Item></Col>
          </Row>
          <Row gutter={16}>
            <Col span={12}><Form.Item label="价格"><InputNumber prefix="¥" style={{ width: '100%' }} /></Form.Item></Col>
            <Col span={12}><Form.Item label="人数上限"><InputNumber style={{ width: '100%' }} /></Form.Item></Col>
          </Row>
          <Form.Item><Button type="primary" htmlType="submit" block>创建课程</Button></Form.Item>
        </Form>
      </Modal>
    </div>
  );
}
