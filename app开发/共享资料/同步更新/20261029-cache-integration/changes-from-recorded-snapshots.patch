+        const stat = fileIo.statSync(path);
+        if (!this.allowed() || !path.startsWith(directory + '/') || path.includes('..') || !stat.isFile() || stat.size <= 0 || AliyunSecureCacheDriver.directoryBytes(directory) > maximumBytes) { this.fail('缓存文件或授权无效'); return; }
