+function setup(){const db=new DB(':memory:');db.exec("CREATE TABLE Member(id INTEGER PRIMARY KEY,phone TEXT,status TEXT,merged_to_member_id INTEGER);INSERT INTO Member VALUES(1,'13800000000','active',0),(2,'13900000000','active',0);CREATE TABLE CourseVideo(id INTEGER,material_id INTEGER,name TEXT,course_id INTEGER);INSERT INTO CourseVideo VALUES(10,1,'第一课',20);CREATE TABLE OnlineCourse(id INTEGER,series_id INTEGER);INSERT INTO OnlineCourse VALUES(20,30);CREATE TABLE CourseSeries(id INTEGER,status TEXT);INSERT INTO CourseSeries VALUES(30,'published');CREATE TABLE Material(id INTEGER,vod_video_id TEXT,updated_at TEXT,type TEXT);INSERT INTO Material VALUES(1,'0123456789abcdef0123456789abcdef','v1','video');CREATE TABLE CourseAuthorization(member_id INTEGER,series_id INTEGER,status TEXT,expire_at TEXT);INSERT INTO CourseAuthorization VALUES(1,30,'active',NULL)");session.ensureAppSchema(db);return db;}
+const env=['APP_VOD_CACHE_ENABLED','APP_VOD_DOWNLOAD_MODE','APP_VOD_CACHE_ACCEPTED_PLATFORMS'];
+async function run(fn){const prior=env.map(k=>process.env[k]);const db=setup();Object.assign(process.env,{APP_VOD_CACHE_ENABLED:'true',APP_VOD_DOWNLOAD_MODE:'secure',APP_VOD_CACHE_ACCEPTED_PLATFORMS:'ios,android,harmony'});try{await fn(db)}finally{db.close();env.forEach((k,i)=>prior[i]===undefined?delete process.env[k]:process.env[k]=prior[i]);}}
