+test('offline expiry is capped at 24h and SQLite China time is explicit',()=>{const now=Date.parse('2026-10-29T10:00:00+08:00');assert.equal(policy.authorizationDeadline(null,now),now+86400000);assert.equal(policy.authorizationDeadline('2026-10-29 11:00:00',now),now+3600000);assert.throws(()=>policy.authorizationDeadline('bad',now));assert.throws(()=>policy.authorizationDeadline('2026-10-28 11:00:00',now));});
+test('verified member, session and lesson are bound; no raw URL or client identity trusted',()=>run(async db=>{const c=session.createAppSession(db,1,'phone');const lease=await policy.authorizeVideoCache(db,c.token,'ios',10,{...body,member_id:2},async()=>({play_auth:'short-lived',expires_in:300,region:'cn-shenzhen'}));assert.equal(lease.member_id,1);assert.equal(lease.lesson_id,10);assert.equal(lease.series_id,30);assert.equal(lease.session_id,c.sessionId);assert.ok(lease.expires_at-lease.issued_at<=86400000);assert.equal(lease.play_url,undefined);}));
