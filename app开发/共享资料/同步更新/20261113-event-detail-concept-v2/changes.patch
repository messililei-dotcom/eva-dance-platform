+    static func ageGroup(_ row: JSONValue) -> String {
+        let text = ["name", "ageRange", "category"].map { row[$0].text }.joined(separator: " ").lowercased()
+        if text.range(of: #"青少年|少年|\bteen(?:ager)?s?\b|\byouth\b"#, options: .regularExpression) != nil { return "青少年" }
+        if text.range(of: #"少儿|幼儿|儿童|\bchildren\b|\bchild\b|\bkids?\b"#, options: .regularExpression) != nil { return "少儿" }
+        if text.range(of: #"成人|成年|\badults?\b"#, options: .regularExpression) != nil { return "成人" }
+        let age = row["ageRange"].text.replacingOccurrences(of: " ", with: "").replacingOccurrences(of: "岁", with: "")
+        let normalized = ["—", "–", "~", "～", "至"].reduce(age) { $0.replacingOccurrences(of: $1, with: "-") }
+        let parts = normalized.split(separator: "-", omittingEmptySubsequences: false)
+        if parts.count == 2, let low = Int(parts[0]), let high = Int(parts[1]), high >= low {
+            if low >= 18 { return "成人" }
+            if low >= 12 && high < 18 { return "青少年" }
+            if high < 12 { return "少儿" }
+        }
+        if (age.hasSuffix("+") || age.hasSuffix("以上")), let low = Int(age.prefix(while: { $0.isNumber })), low >= 18 { return "成人" }
+        return ""
+    }
