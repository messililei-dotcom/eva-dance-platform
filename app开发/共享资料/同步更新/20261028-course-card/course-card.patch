+++ after/app开发/iOS/EvaDance/Sources/EvaDanceApp/CourseCardSplitLayout.swift
@@ -0,0 +1,21 @@
+import SwiftUI
+
+/// Equal image and text widths; the row grows with the text instead of clipping it.
+struct CourseCardSplitLayout: Layout {
+    private let gap: CGFloat = 12
+    func sizeThatFits(proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) -> CGSize {
+        let width = max(0, proposal.width ?? 360)
+        let column = max(0, (width - gap) / 2)
+        let text = subviews.last?.sizeThatFits(ProposedViewSize(width: column, height: nil)) ?? .zero
+        return CGSize(width: width, height: max(column, text.height))
+    }
+    func placeSubviews(in bounds: CGRect, proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) {
+        guard subviews.count == 2 else { return }
+        let column = max(0, (bounds.width - gap) / 2)
+        let text = subviews[1].sizeThatFits(ProposedViewSize(width: column, height: nil))
+        subviews[0].place(at: CGPoint(x: bounds.minX, y: bounds.midY - column / 2),
+                         proposal: ProposedViewSize(width: column, height: column))
+        subviews[1].place(at: CGPoint(x: bounds.minX + column + gap, y: bounds.midY - text.height / 2),
+                         proposal: ProposedViewSize(width: column, height: text.height))
+    }
+}
