.shop-page{padding:28rpx 28rpx 180rpx;background:#f5f4ef;min-height:100vh;color:#262721}.shop-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:24rpx}.brand{font-size:40rpx;font-weight:700}.subtitle{font-size:24rpx;color:#77796e;margin-top:10rpx}.search,.field{background:#fff;border:1rpx solid #dcdfd3;border-radius:14rpx;padding:20rpx 24rpx;font-size:28rpx;margin:18rpx 0;width:100%}.search{height:82rpx}.address{height:150rpx;box-sizing:border-box}.categories{margin:22rpx 0;white-space:nowrap}.category-list{display:flex;gap:14rpx}.chip{display:inline-flex;background:#fff;border:1rpx solid #dcdfd3;border-radius:32rpx;padding:14rpx 28rpx;font-size:25rpx}.chip.selected{background:#204b3d;color:#fff}.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.product-card,.panel{background:#fff;border-radius:20rpx;overflow:hidden}.product-card image,.image-placeholder{width:100%;height:350rpx;background:#e9ece3}.image-placeholder{display:flex;align-items:center;justify-content:center;color:#879080;font-size:30rpx}.product-info{padding:20rpx}.product-name{font-size:29rpx;font-weight:600;line-height:1.45}.muted{color:#7a7d71;font-size:24rpx;line-height:1.6}.price{color:#204b3d;font-size:32rpx;font-weight:700}.big{font-size:44rpx;margin-bottom:18rpx}.stock{float:right;color:#888;font-size:22rpx;font-weight:400;margin-top:8rpx}.panel{padding:26rpx;margin:22rpx 0}.hero-image{width:100%;height:680rpx;border-radius:20rpx;background:#e9ece3}.spec{padding:24rpx 0;color:#62665c}.row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:16rpx 0}.primary,.outline{padding:19rpx 25rpx;border-radius:14rpx;font-size:26rpx;line-height:1.3;white-space:nowrap}.primary{background:#204b3d;color:#fff}.outline{border:1rpx solid #cfd4c7;color:#204b3d;background:#fff}.primary[disabled],.outline[disabled]{opacity:.45}.text-button{color:#204b3d;font-size:25rpx;padding:10rpx 0}.bottom-bar{position:fixed;bottom:0;left:0;right:0;padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:#fff;display:flex;align-items:center;justify-content:space-between;gap:12rpx;border-top:1rpx solid #e7e8e1;z-index:10;font-size:27rpx}.quantity{display:flex;align-items:center;gap:22rpx;font-size:28rpx}.quantity button{background:#f1f3ed;border-radius:10rpx;width:58rpx;height:58rpx;line-height:58rpx}.empty{text-align:center;color:#777;padding:80rpx 18rpx;font-size:28rpx}.empty button{margin:24rpx auto}.error{color:#a23a34;font-size:26rpx;padding:14rpx 0}.line-item{display:flex;gap:22rpx}.line-item image{width:140rpx;height:160rpx;border-radius:12rpx}.grow{flex:1}.section-title{font-size:31rpx;font-weight:600;margin:0}.status{font-size:27rpx;color:#204b3d}.order-id{color:#888;font-size:21rpx;word-break:break-all}.order-line{display:flex;justify-content:space-between;gap:16rpx;font-size:25rpx;margin:20rpx 0}.shipping{font-size:25rpx;color:#62665c;line-height:1.6;padding:18rpx 0;border-top:1rpx solid #eee}.actions{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:14rpx;margin-top:18rpx}

.field{height:92rpx;line-height:42rpx}.field.address{height:180rpx;line-height:42rpx}.shop-header>view{flex:1;min-width:0}.shop-header>button{flex-shrink:0}.primary,.outline{width:auto;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}.category-list .chip{width:auto;flex:none;margin:0}
.shop-header .outline{width:180rpx;min-width:180rpx;padding:18rpx 14rpx}.shop-header .subtitle{font-size:23rpx;line-height:1.6}
