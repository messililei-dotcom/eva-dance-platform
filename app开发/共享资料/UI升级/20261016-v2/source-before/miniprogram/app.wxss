page {
  min-height: 100%;
  background: #f6f6f6;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1.3;
}

button::after {
  border: 0;
}

.page {
  padding: 28rpx 28rpx 44rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #202124;
}

.section-title .more {
  font-size: 26rpx;
  font-weight: 500;
  color: #ff5b45;
}

.card {
  border: 1rpx solid rgba(32, 33, 36, 0.06);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(32, 33, 36, 0.05);
}

.primary-btn,
.ghost-btn,
.gold-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-btn {
  color: #ffffff;
  background: #ff5b45;
}

.gold-btn {
  color: #ffffff;
  background: #ff5b45;
}

.ghost-btn {
  color: #ff5b45;
  border: 1rpx solid rgba(255, 91, 69, 0.28);
  background: #ffffff;
}

.muted {
  color: #8c8172;
}

.price {
  color: #ff5b45;
  font-weight: 800;
}

.empty {
  padding: 56rpx 24rpx;
  text-align: center;
  color: #8c8172;
}


