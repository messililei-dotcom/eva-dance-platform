<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}"><template is="publicSharePreview" data="{{card:sharePreview}}" /></block>
<block wx:else>
<view class="login-container">
  <view class="logo-section">
    <image class="logo" src="/images/logo-20261005.png" mode="aspectFit" />
    <text class="title">伊娃东方舞</text>
    <text class="subtitle">舞者成长系统</text>
  </view>

  <view class="form-section">
    <button
      class="wechat-login-btn {{phoneLogging ? 'disabled' : ''}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="loginByPhoneAuth"
      disabled="{{phoneLogging || logging}}"
    >
      {{phoneLogging ? '登录中...' : '手机一键登录'}}
    </button>

    <view class="divider">
      <view></view>
      <text>或使用验证码登录</text>
      <view></view>
    </view>

    <view class="input-group">
      <text class="input-label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入手机号"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-group">
      <text class="input-label">验证码</text>
      <view class="code-row">
        <input
          class="input code-input"
          type="number"
          maxlength="6"
          value="{{code}}"
          placeholder="请输入验证码"
          bindinput="onCodeInput"
        />
        <button
          class="code-btn {{sending || countdown ? 'disabled' : ''}}"
          disabled="{{sending || countdown}}"
          bindtap="sendCode"
        >
          {{countdown ? countdown + 's' : (sending ? '发送中' : '获取验证码')}}
        </button>
      </view>
    </view>

    <button
      class="login-btn {{logging ? 'disabled' : ''}}"
      disabled="{{logging || phoneLogging}}"
      bindtap="login"
    >
      {{logging ? '登录中...' : '验证码登录'}}
    </button>

    <text class="hint">授权失败时可使用短信验证码登录</text>
  </view>

  <view class="back-btn" bindtap="goBack">
    <text>返回</text>
  </view>
</view>

</block>
