.page {
  min-height: 100vh;
  padding: 20rpx;
  background: #f6f7f9;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e4e7ec;
  border-top-color: #ff5b45;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #8c8172;
  font-size: 26rpx;
}

/* 头像区域 */
.avatar-section {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-label {
  color: #202124;
  font-size: 30rpx;
  font-weight: 800;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #ff5b45;
  font-size: 40rpx;
  font-weight: 800;
  overflow: hidden;
}

.avatar-img {
  display: block;
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
}

/* 表单区域 */
.form-section {
  padding: 0 28rpx;
  margin-bottom: 16rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0e6da;
}

.form-item:last-child {
  border-bottom: 0;
}

.form-label {
  flex: 0 0 160rpx;
  color: #202124;
  font-size: 28rpx;
  font-weight: 800;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  color: #3e4652;
  background: #fffaf4;
  font-size: 28rpx;
  text-align: right;
}

.form-value {
  color: #3e4652;
  font-size: 28rpx;
  text-align: right;
}

.form-value.readonly {
  color: #8c8172;
}

.form-value.actionable {
  color: #ff5b45;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: #fffaf4;
}

/* 保存提示 */
.save-hint {
  text-align: center;
  padding: 20rpx 0;
  color: #8c8172;
  font-size: 24rpx;
}
