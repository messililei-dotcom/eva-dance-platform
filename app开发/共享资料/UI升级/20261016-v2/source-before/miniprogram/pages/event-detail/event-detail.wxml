<import src="../../shared/share-preview.wxml" />
<block wx:if="{{sharePreview}}"><template is="publicSharePreview" data="{{card:sharePreview}}" /></block>
<block wx:else>
<view class="detail-page">
  <view wx:if="{{loading}}" class="empty-card">赛事加载中…</view>
  <block wx:else>
    <view class="event-cover">
      <image wx:if="{{competition.coverUrl}}" src="{{competition.coverUrl}}" mode="aspectFill"></image><view wx:else class="cover-fallback">赛事</view>
      <view class="cover-shade"></view>
      <view class="cover-content"><view class="event-code">{{competition.code}}</view><view class="event-title">{{competition.name}}</view><view class="event-date">{{competition.dateText}} · {{competition.location || '地点待定'}}</view></view>
    </view>
    <button class="judge-entry" bindtap="goJudge">评委入口</button>
    <view class="summary-card card"><view><text>{{competition.groupCount || groups.length || 0}}</text><text class="summary-label">组别</text></view><view><text>{{competition.registrationPublic ? (competition.approvedPlayerCount || players.length || 0) : '—'}}</text><text class="summary-label">选手</text></view><view><text>{{competition.judgeCount || judges.length || 0}}</text><text class="summary-label">评委</text></view></view>
    <scroll-view class="panel-tabs" scroll-x enable-flex><view class="panel-tab {{activePanel === item.key ? 'active' : ''}}" wx:for="{{panels}}" wx:key="key" data-key="{{item.key}}" bindtap="switchPanel">{{item.label}}</view></scroll-view>
    <view wx:if="{{activePanel === 'overview'}}">
      <view class="section-card card"><view class="section-title">赛事信息</view><view class="info-row"><text>主办方</text><span>{{competition.organizer || '伊娃东方舞'}}</span></view><view class="info-row"><text>比赛地点</text><span>{{competition.location || '待定'}}</span></view><view class="info-row"><text>报名状态</text><span class="highlight">{{competition.registrationText}}</span></view><view class="info-row"><text>报名费用</text><span>{{competition.feeText}}</span></view><view class="description">{{competition.description || '赛事介绍正在完善中。'}}</view></view>
      <view class="section-card card" wx:if="{{sessions.length}}"><view class="section-title">赛事日程</view><view class="list-row" wx:for="{{sessions}}" wx:key="id"><view><b>{{item.name}}</b><small>{{item.timeText}} · {{item.venue || '场地待定'}}</small></view></view></view>
      <view class="section-card card" wx:if="{{registrations.length}}"><view class="section-title">我的报名</view><view class="list-row" wx:for="{{registrations}}" wx:key="id"><view><b>{{item.name}} · {{item.groupName}}</b><small>审核：{{item.auditStatusText}} · 缴费：{{item.paidStatusText}}</small><small>{{item.performanceTitle ? '作品：' + item.performanceTitle + ' · ' : ''}}{{item.resultText}}</small></view></view></view>
    </view>
    <view wx:if="{{activePanel === 'groups'}}" class="section-card card"><view class="group-search"><input value="{{groupKeyword}}" placeholder="搜索组别、舞种或年龄" bindinput="onGroupSearch" /></view><view class="list-row group-row" wx:for="{{visibleGroups}}" wx:key="id" data-id="{{item.id}}" bindtap="openGroup"><view><b>{{item.ordinal}}. {{item.name}}</b><small>{{item.rankingCount ? item.rankingCount + ' 项成绩' : '成绩待公布'}}</small></view><text>{{item.playerCountText}} ›</text></view><view class="pagination" wx:if="{{groupPageCount > 1}}"><button data-offset="-1" disabled="{{groupPage <= 1}}" bindtap="changeGroupPage">上一页</button><text>{{groupPage}} / {{groupPageCount}} · {{groupTotal}} 组</text><button data-offset="1" disabled="{{groupPage >= groupPageCount}}" bindtap="changeGroupPage">下一页</button></view><view wx:if="{{!visibleGroups.length}}" class="panel-empty">没有找到符合条件的组别</view></view>
    <view wx:if="{{activePanel === 'players'}}" class="section-card card"><view class="list-row" wx:for="{{players}}" wx:key="id" data-id="{{item.id}}" data-group="{{item.groupId}}" bindtap="openPlayer"><image class="row-avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="number">{{item.displayInitial}}</view><view><b>{{item.name}}</b><small>{{item.groupName}} · {{item.organization || item.teacher || '个人参赛'}}</small></view></view><view wx:if="{{!players.length}}" class="panel-empty">{{competition.registrationPublic ? '暂无报名信息' : '报名信息尚未公开'}}</view></view>
    <view wx:if="{{activePanel === 'judges'}}" class="section-card card"><view class="list-row" wx:for="{{judges}}" wx:key="id"><view><b>{{item.name}}</b><small>{{item.title || '赛事评委'}} · {{item.organization || '伊娃东方舞'}}</small></view></view><view wx:if="{{!judges.length}}" class="panel-empty">评委阵容暂未公布</view></view>
    <view wx:if="{{activePanel === 'results'}}" class="results-panel"><view class="results-head"><view class="section-title">公示结果</view><text>成绩由赛事平台审核发布</text></view><view class="result-card" wx:for="{{rankings}}" wx:key="id" data-id="{{item.playerId}}" data-group="{{item.groupId}}" bindtap="openPlayer"><view class="result-trophy {{item.rankClass}}"><view wx:if="{{item.rankNo}}">🏆</view><text>{{item.rankLabel}}</text></view><image class="row-avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view class="result-main"><b>{{item.playerName}}</b><small>{{item.groupName}} · {{item.playerNo ? '编号 ' + item.playerNo : '未编号'}}</small></view><view class="result-score"><view>{{item.scoreText}}</view><text>最终得分</text></view><text class="result-arrow">›</text></view><view wx:if="{{!rankings.length}}" class="section-card card panel-empty">成绩经统一平台审核发布后在这里公示</view></view>
    <view class="section-card card" wx:if="{{registrations.length}}"><view class="section-title">我的报名</view><view class="list-row" wx:for="{{registrations}}" wx:key="id"><view><b>{{item.entrantName}} · {{item.groupName}}</b><small>{{item.performanceTitle}} · {{item.paidStatusText}}</small></view><button wx:if="{{item.canPay}}" data-id="{{item.id}}" bindtap="payRegistration">继续缴费</button></view></view><button class="register-btn {{competition.registrationOpen ? '' : 'disabled'}}" bindtap="goRegister">{{competition.registrationOpen ? '立即报名' : '报名已关闭'}}</button>
  </block>
</view>

</block>
