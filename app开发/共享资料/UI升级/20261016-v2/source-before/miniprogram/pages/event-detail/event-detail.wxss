.detail-page{min-height:100vh;padding:20rpx 20rpx 150rpx;background:#f8f3ea}.event-cover{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border-radius:24rpx 24rpx 0 0;background:#1a1a1a}.event-cover image,.cover-fallback{width:100%;height:100%}.cover-fallback{display:flex;align-items:center;justify-content:center;color:#c8a96e;background:linear-gradient(135deg,#8b1a1a,#7e6233);font-size:52rpx;font-weight:900}.cover-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06),rgba(26,26,26,.9))}.cover-content{position:absolute;left:26rpx;right:26rpx;bottom:28rpx;color:#fff}.event-code{display:inline-flex;padding:6rpx 12rpx;border-radius:999rpx;color:#c8a96e;background:rgba(255,255,255,.1);font-size:19rpx;font-weight:800}.event-title{margin-top:10rpx;font-size:37rpx;line-height:1.3;font-weight:900}.event-date{margin-top:10rpx;color:rgba(255,255,255,.72);font-size:22rpx}.summary-card{display:grid;grid-template-columns:repeat(3,1fr);margin-top:0;padding:20rpx 8rpx;border-radius:0 0 20rpx 20rpx}.summary-card view{display:flex;flex-direction:column;align-items:center;border-right:1rpx solid #eee}.summary-card view:last-child{border:0}.summary-card text{font-size:32rpx;font-weight:900}.summary-card .summary-label{margin-top:5rpx;color:#858c96;font-size:20rpx;font-weight:500}.panel-tabs{margin:22rpx 0 16rpx;white-space:nowrap}.panel-tab{display:inline-flex;margin-right:10rpx;padding:13rpx 25rpx;border-radius:999rpx;color:#746656;background:#fff;font-size:24rpx;font-weight:800}.panel-tab.active{color:#fff;background:#9f1d20}.section-card{margin-bottom:16rpx;padding:24rpx}.section-title{margin-bottom:18rpx;font-size:30rpx;font-weight:900}.info-row{display:flex;justify-content:space-between;gap:18rpx;padding:14rpx 0;border-bottom:1rpx solid #f1e7d8;font-size:24rpx}.info-row text{color:#817465}.info-row span{text-align:right}.info-row .highlight{color:#9f1d20;font-weight:900}.description{padding-top:20rpx;color:#6f6257;font-size:24rpx;line-height:1.75}.group-search{height:70rpx;margin-bottom:10rpx;padding:0 20rpx;border:1rpx solid #e8ddcb;border-radius:999rpx;background:#fbf8f2}.group-search input{height:70rpx;font-size:23rpx}.list-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #f1e7d8}.list-row>view:not(.number):not(.rank){display:flex;min-width:0;flex:1;flex-direction:column}.list-row b{font-size:26rpx}.list-row small{margin-top:7rpx;color:#8a7a68;font-size:21rpx}.number,.rank{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:15rpx;color:#fff;background:#2c1810;font-size:21rpx;font-weight:900}.rank{color:#8a5b11;background:#fff1d8;font-size:28rpx}.score{color:#9f1d20;font-size:29rpx;font-weight:900}.panel-empty,.empty-card{padding:68rpx 22rpx;color:#8a7a68;text-align:center;font-size:24rpx}.empty-card{border-radius:20rpx;background:#fff}.register-btn{position:fixed;left:28rpx;right:28rpx;bottom:30rpx;height:86rpx;border-radius:14rpx;color:#fff;background:#9f1d20;font-size:30rpx;line-height:86rpx;font-weight:900;box-shadow:0 10rpx 28rpx rgba(159,29,32,.24)}.register-btn.disabled{background:#aeb3ba}
.group-row{position:relative;padding-right:4rpx}.results-head{display:flex;align-items:end;justify-content:space-between;gap:18rpx;margin:4rpx 4rpx 16rpx}.results-head .section-title{margin:0}.results-head>text{color:#8a7a68;font-size:20rpx}.result-card{display:grid;grid-template-columns:70rpx minmax(0,1fr) 92rpx 20rpx;align-items:center;gap:12rpx;min-height:112rpx;margin-bottom:12rpx;padding:14rpx;border:1rpx solid #eadfce;border-radius:18rpx;background:#fff}.result-trophy{text-align:center}.result-trophy>view{font-size:34rpx;line-height:1}.result-trophy.silver>view{filter:grayscale(1);opacity:.65}.result-trophy.bronze>view{filter:sepia(1);opacity:.78}.result-trophy.normal>view{opacity:.5}.result-trophy text{display:block;margin-top:4rpx;color:#8a7a68;font-size:17rpx}.result-main{display:flex;min-width:0;flex-direction:column}.result-main b{overflow:hidden;color:#2c1810;font-size:26rpx;text-overflow:ellipsis;white-space:nowrap}.result-main small{margin-top:7rpx;overflow:hidden;color:#8a7a68;font-size:19rpx;text-overflow:ellipsis;white-space:nowrap}.result-score{text-align:right}.result-score view{color:#9f1d20;font-size:28rpx;font-weight:900}.result-score text{display:block;margin-top:5rpx;color:#8a7a68;font-size:16rpx}.result-arrow{color:#9a793d;font-size:28rpx}

.judge-entry{margin:20rpx 0;background:#9f1d20;color:#fff;font-size:28rpx;}

.row-avatar{width:78rpx;height:78rpx;flex-shrink:0;border-radius:50%}.pagination{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:24rpx;font-size:24rpx}.pagination button{width:auto;font-size:24rpx;background:#fff;color:#9f1d20}
