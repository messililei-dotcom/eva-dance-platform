.page {
  min-height: 100vh;
  padding: 18rpx 20rpx 36rpx;
  background: #f6f7f9;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 10rpx 0 18rpx;
}

.section-head > view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 0 0 auto;
}

.section-kicker {
  color: #202124;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
}

.hero-head .section-kicker {
  font-size: 36rpx;
}

.section-title {
  color: #202124;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 900;
}

.hero-head {
  margin-top: 2rpx;
}

.course-swiper {
  width: 100%;
  height: 532.5rpx;
  overflow: hidden;
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 20rpx;
  background: #2d3541;
  box-shadow: 0 18rpx 42rpx rgba(38, 44, 56, 0.13);
}

.hero-slide image,
.cover-fallback {
  width: 100%;
  height: 100%;
}

.hero-slide image,
.row-cover image {
  display: block;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #334965 0%, #8d5d57 54%, #c66a45 100%);
  font-size: 34rpx;
  font-weight: 900;
}

.slide-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(17, 20, 26, 0.84) 100%);
}

.slide-content {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 24rpx;
  color: #ffffff;
}

.slide-badge,
.row-badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.slide-badge {
  padding: 7rpx 14rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
}

.slide-title {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.22;
  font-weight: 900;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.slide-meta {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  font-weight: 700;
}

.list-head {
  margin-top: 34rpx;
}

.section-head > .list-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex: 1 1 auto;
  min-width: 0;
}

.all-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 9rpx 14rpx;
  border: 0;
  border-radius: 12rpx;
  color: #9f1d20;
  background: #fff0ed;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 900;
}

.inline-search {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 56rpx;
  flex: 0 1 218rpx;
  width: 218rpx;
  align-items: center;
  height: 58rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(32, 33, 36, 0.08);
  box-shadow: 0 6rpx 14rpx rgba(32, 33, 36, 0.04);
}

.search-input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 58rpx;
  padding: 0 12rpx 0 20rpx;
  color: #202124;
  font-size: 22rpx;
  line-height: 58rpx;
  font-weight: 700;
}

.inline-search.has-keyword .search-input {
  padding-right: 50rpx;
}

.search-clear-btn {
  position: absolute;
  right: 64rpx;
  top: 50%;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: #ffffff;
  background: #aeb4bc;
  font-size: 28rpx;
  line-height: 28rpx;
  transform: translateY(-50%);
}

.search-icon-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #2f3a48;
}

.search-icon {
  position: relative;
  width: 19rpx;
  height: 19rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 13rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ffffff;
  content: "";
  transform: rotate(45deg);
  transform-origin: center;
}

.all-btn::after,
.search-icon-btn::after,
.search-clear-btn::after {
  border: 0;
}

.search-result {
  margin: -8rpx 0 14rpx;
  color: #7e8591;
  font-size: 22rpx;
  font-weight: 800;
}

.bottom-all-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin: 22rpx 0 8rpx;
  border: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #9f1d20;
  font-size: 28rpx;
  line-height: 76rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(240, 91, 70, 0.2);
}

.course-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.course-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18rpx;
  min-height: 138rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(32, 33, 36, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(32, 33, 36, 0.04);
}

.row-cover {
  width: 100%;
  height: 238rpx;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 14rpx;
  background: #2d3541;
}

.row-cover image {
  width: 100%;
  height: 100%;
}

.row-body {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.row-badge {
  padding: 5rpx 12rpx;
  color: #b26840;
  background: #fbf0e5;
}

.row-title {
  margin-top: 12rpx;
  color: #202124;
  font-size: 27rpx;
  line-height: 1.32;
  font-weight: 900;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.row-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
  color: #7e8591;
  font-size: 22rpx;
  font-weight: 700;
}

.empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  border-radius: 18rpx;
  color: #8c8172;
  background: #ffffff;
  border: 1rpx dashed rgba(155, 91, 52, 0.2);
  font-size: 26rpx;
  font-weight: 800;
}
